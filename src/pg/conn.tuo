// pg::conn — the socket: connecting, reading framed messages, writing them.
//
// This is the adapter's **effect tier**. Everything below touches the network,
// so — by the same rule `tuo-stdlib` follows — none of it can appear in a spec
// (`R0007`); it is pinned instead by the live integration program in
// `examples/live_check.tuo`, which runs against a real server. The pure tiers
// (`db::bytes`, `pg::proto`, `pg::message`, `pg::value`, `pg::auth`) carry the
// specs, and they carry the logic worth proving.
//
// A CONNECTION IS AN INT.
//
// v0 has no `Box`, no `Shared`, and no destructors, so a connection cannot be
// an object that closes itself. It is what the OS calls it: a **descriptor**,
// an `Int`, which the caller passes back to every function here and eventually
// hands to `close`. That is honest about the lifetime — nothing pretends to
// manage it — and it costs nothing at runtime.
//
// EVERY WAIT IS BOUNDED.
//
// Every read and the connect itself take a timeout in milliseconds and go
// through ADR-0017's bounded-wait primitives. A database client that blocks
// forever on a peer that has gone away is not a client, it is a hang; the
// blocking forms are deliberately never used here. A timeout reports `-3`,
// which the seam keeps distinct from end-of-input (`-1`) and host error
// (`-2`), so "the server is slow" never gets confused with "the server is
// gone".
//
// READING IS BYTE-AT-A-TIME.
//
// The seam offers `read_byte`, so a message is assembled one byte at a time
// into an owned `String`. That is the only shape available in v0, and for a
// length-prefixed protocol it is exactly sufficient: read five header bytes,
// decode the length, then read precisely that many more. There is no
// over-read, so no buffer to manage and no way to desynchronize the stream.

module pg::conn;

// ----------------------------------------------------------------------------
// Sentinels and defaults.
// ----------------------------------------------------------------------------

/// The default port PostgreSQL listens on.
pub fn default_port() -> Int {
    5432
}

/// A sensible default timeout for a read or a connect: 30 seconds.
pub fn default_timeout_ms() -> Int {
    30000
}

/// The seam's timeout sentinel (ADR-0017).
pub fn timeout_sentinel() -> Int {
    0 - 3
}

/// The seam's end-of-input sentinel.
pub fn eof_sentinel() -> Int {
    0 - 1
}

/// Is `outcome` a usable descriptor?
///
/// # Example
/// ```tuo
/// let ok = pg::conn::is_open(3); // true
/// ```
pub fn is_open(take outcome: Int) -> Bool {
    outcome >= 0
}

// ----------------------------------------------------------------------------
// Opening and closing.
// ----------------------------------------------------------------------------

/// EFFECT: open a TCP connection to `host:port`, waiting at most
/// `timeout_ms`.
///
/// `host` must be a **numeric** address — `"127.0.0.1"` or `"::1"` — because
/// v0 has no DNS (ADR-0017 leaves name resolution to be written in tuonelang
/// on its UDP primitives). The address family is inferred from the literal, so
/// IPv6 works with no separate spelling.
///
/// Returns the descriptor, or a typed error distinguishing a timeout from a
/// refused connection — the two an operator diagnoses differently.
///
/// # Example
/// ```tuo
/// // let c = pg::conn::open("127.0.0.1", 5432, 5000);
/// ```
pub fn open(in host: Str, take port: Int, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let fd = std::rt::connect_timeout(host, port, timeout_ms);
    if fd == timeout_sentinel() {
        var m = std::string::empty();
        std::string::append(m, "timed out connecting to ");
        std::string::append(m, host);
        return Err { error: db::error::new(db::error::kind_timeout(), std::string::as_str(m)) };
    }
    if fd < 0 {
        var m = std::string::empty();
        std::string::append(m, "could not connect to ");
        std::string::append(m, host);
        std::string::append(m, " (is the server running and reachable?)");
        return Err { error: db::error::new(db::error::kind_connection(), std::string::as_str(m)) };
    }
    Ok { value: fd }
}

/// EFFECT: close a connection's descriptor. Safe to call on an error path.
///
/// # Example
/// ```tuo
/// // let _ = pg::conn::close(fd);
/// ```
pub fn close(take fd: Int) -> Int {
    std::rt::close(fd)
}

/// EFFECT: send `Terminate` and close — the courteous disconnect, which lets
/// the server release the backend immediately rather than waiting for the
/// socket to drop.
///
/// # Example
/// ```tuo
/// // let _ = pg::conn::shutdown(fd);
/// ```
pub fn shutdown(take fd: Int) -> Int {
    let _ = write_message(fd, pg::proto::terminate());
    close(fd)
}

// ----------------------------------------------------------------------------
// Writing.
// ----------------------------------------------------------------------------

/// EFFECT: write a complete encoded message to the socket.
///
/// Returns the number of bytes written, or a negative host error.
///
/// # Example
/// ```tuo
/// // let n = pg::conn::write_message(fd, pg::proto::query("SELECT 1"));
/// ```
pub fn write_message(take fd: Int, in msg: String) -> Int {
    std::rt::write_string(fd, msg)
}

/// EFFECT: write a message and classify the outcome as a typed error.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::send(fd, pg::proto::sync());
/// ```
pub fn send(take fd: Int, in msg: String) -> Result[Int, db::error::PgError] {
    let n = write_message(fd, msg);
    if n < 0 {
        return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while sending (the server may have closed it)") };
    }
    Ok { value: n }
}

// ----------------------------------------------------------------------------
// Reading.
//
// The header/payload split is what makes framing impossible to get wrong: the
// length is read before any payload byte, so the reader always knows exactly
// how many bytes belong to this message.
// ----------------------------------------------------------------------------

/// EFFECT: read exactly `count` bytes into a new owned `String`.
///
/// Returns a typed error on timeout, end of input, or host error — each
/// distinguished, because a truncated message and a slow one need different
/// responses.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::read_exact(fd, 5, 30000);
/// ```
pub fn read_exact(take fd: Int, take count: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    var out = std::string::empty();
    var i = 0;
    while i < count {
        let b = std::rt::read_byte_timeout(fd, timeout_ms);
        if b == timeout_sentinel() {
            return Err { error: db::error::new(db::error::kind_timeout(), "timed out waiting for the server to send more data") };
        }
        if b == eof_sentinel() {
            return Err { error: db::error::new(db::error::kind_connection(), "the server closed the connection mid-message") };
        }
        if b < 0 {
            return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while receiving") };
        }
        std::string::push_byte(out, b);
        i = i + 1;
    }
    Ok { value: out }
}

/// EFFECT: read one complete backend message, returning its **type byte**.
///
/// The payload is returned separately by `read_message_payload`; this pair
/// exists because v0 has no tuples and no generic pair type that would let one
/// call return both. In practice the caller reads the type, branches on it,
/// and reads the payload — which is the natural shape anyway.
///
/// Use `read_message` for the combined form.
///
/// # Example
/// ```tuo
/// // let t = pg::conn::read_type(fd, 30000);
/// ```
pub fn read_type(take fd: Int, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    match read_exact(fd, 1, timeout_ms) {
        Ok { value } => Ok { value: std::string::byte_at(value, 0) },
        Err { error } => Err { error: error },
    }
}

/// EFFECT: read a message's payload, given that its type byte was already
/// consumed.
///
/// Reads the Int32 length, subtracts the four bytes the length field itself
/// occupies, and reads exactly that many payload bytes.
///
/// A length below 4 is a protocol violation (it would claim the message is
/// shorter than its own header), and is reported rather than used to compute a
/// negative read count.
///
/// # Example
/// ```tuo
/// // let p = pg::conn::read_message_payload(fd, 30000);
/// ```
pub fn read_message_payload(take fd: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    match read_exact(fd, 4, timeout_ms) {
        Ok { value } => read_body_of_length(fd, db::bytes::be_i32(value, 0), timeout_ms),
        Err { error } => Err { error: error },
    }
}

/// EFFECT: read the payload of a message whose declared length is `len`.
///
/// Split out of `read_message_payload` so the length check has somewhere to
/// live: a `match` arm in this build takes an expression, not a statement
/// block, so multi-step arms become named functions — which reads better here
/// regardless.
///
/// A length below 4 would claim the message is shorter than its own header, so
/// it is a protocol violation rather than a read count.
pub fn read_body_of_length(take fd: Int, take len: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    if len < 4 {
        return Err { error: db::error::new(db::error::kind_protocol(), "the server declared a message length below the 4-byte minimum") };
    }
    read_exact(fd, len - 4, timeout_ms)
}

// ----------------------------------------------------------------------------
// The handshake.
// ----------------------------------------------------------------------------

/// EFFECT: perform the startup handshake on an open descriptor.
///
/// Sends the startup packet, then consumes messages until the server either
/// authenticates the connection (`ReadyForQuery`) or refuses it. Along the way
/// it absorbs the `ParameterStatus` and `BackendKeyData` messages every server
/// sends, which must be drained or they desynchronize the next query.
///
/// Authentication is delegated to `pg::auth`: cleartext is answered here, and
/// anything needing crypto is refused with the typed error that names the fix
/// (see the ADR-0019 seam in that module).
///
/// # Example
/// ```tuo
/// // let r = pg::conn::handshake(fd, "postgres", "app", "", 30000);
/// ```
pub fn handshake(take fd: Int, in user: Str, in database: Str, in password: Str, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let sent = write_message(fd, pg::proto::startup(user, database));
    if sent < 0 {
        return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while sending the startup packet") };
    }

    // Bound the exchange so a misbehaving peer cannot spin this loop forever.
    var guard = 0;
    while guard < 1000 {
        guard = guard + 1;

        // Read one message: type byte, then payload.
        let type_result = read_type(fd, timeout_ms);
        if !is_ok_int(type_result) {
            return Err { error: unwrap_err_int(type_result) };
        }
        let type_byte = unwrap_ok_int(type_result);

        let payload_result = read_message_payload(fd, timeout_ms);
        if !is_ok_string(payload_result) {
            return Err { error: unwrap_err_string(payload_result) };
        }
        let payload = unwrap_ok_string(payload_result);

        if type_byte == pg::proto::be_error_response() {
            return Err { error: error_from_payload(payload) };
        }

        if type_byte == pg::proto::be_authentication() {
            let outcome = respond_to_auth(fd, payload, password);
            if outcome != 0 {
                return Err { error: pg::auth::unsupported_error(pg::message::auth_kind(payload)) };
            }
        } else if type_byte == pg::proto::be_ready_for_query() {
            // The handshake is complete; report the transaction status.
            return Ok { value: pg::message::tx_status(payload) };
        }
    // ParameterStatus, BackendKeyData, and NoticeResponse are absorbed:
    // they carry useful information but nothing the handshake must act on.
    }

    Err { error: db::error::new(db::error::kind_protocol(), "the server sent too many messages without completing the handshake") }
}

/// EFFECT: answer one `AuthenticationRequest`. Returns `0` when the exchange
/// may continue, and non-zero when the demanded method cannot be performed.
///
/// Split from `handshake` so the authentication policy is one readable
/// function rather than a nested branch inside a loop.
pub fn respond_to_auth(take fd: Int, in payload: String, in password: Str) -> Int {
    let k = pg::message::auth_kind(payload);
    let p = pg::auth::plan(k);
    if p == pg::auth::plan_ok() {
        // Authenticated; the caller keeps draining until ReadyForQuery.
        0
    } else if p == pg::auth::plan_cleartext() {
        let n = write_message(fd, pg::proto::password(password));
        if n < 0 {
            1
        } else {
            0
        }
    } else {
        // md5 / SCRAM / Kerberos / GSSAPI — refused with a typed error by the
        // caller, which has the auth kind to name it.
        1
    }
}

// ----------------------------------------------------------------------------
// Result helpers.
//
// A `match` arm in this build takes an expression, not a statement block, so
// the "inspect, then act" shape a protocol loop needs is expressed with these
// small named projections instead of nested blocks.
// ----------------------------------------------------------------------------

/// Is this `Result[Int, PgError]` an `Ok`? Borrows rather than consumes, so
/// the caller can inspect a result and still unwrap it afterwards — a `match`
/// on an owned value moves it (`O0001`).
pub fn is_ok_int(in r: Result[Int, db::error::PgError]) -> Bool {
    match r {
        Ok { value: _ } => true,
        Err { error: _ } => false,
    }
}

/// The value of a successful `Result[Int, PgError]`, or `-1`.
pub fn unwrap_ok_int(in r: Result[Int, db::error::PgError]) -> Int {
    match r {
        // `Int` is Copy, so reading it out of a borrow is a copy, not a move.
        Ok { value } => value,
        Err { error: _ } => 0 - 1,
    }
}

/// Is this `Result[String, PgError]` an `Ok`?
pub fn is_ok_string(in r: Result[String, db::error::PgError]) -> Bool {
    match r {
        Ok { value: _ } => true,
        Err { error: _ } => false,
    }
}

/// The error of a failed `Result[Int, PgError]`, or a protocol error when it
/// was actually `Ok` (which the callers above never do).
pub fn unwrap_err_int(take r: Result[Int, db::error::PgError]) -> db::error::PgError {
    match r {
        Ok { value: _ } => db::error::new(db::error::kind_protocol(), "expected an error"),
        Err { error } => error,
    }
}

/// The error of a failed `Result[String, PgError]`.
pub fn unwrap_err_string(take r: Result[String, db::error::PgError]) -> db::error::PgError {
    match r {
        Ok { value: _ } => db::error::new(db::error::kind_protocol(), "expected an error"),
        Err { error } => error,
    }
}

/// The value of a successful `Result[String, PgError]`, or the empty string.
pub fn unwrap_ok_string(take r: Result[String, db::error::PgError]) -> String {
    match r {
        Ok { value } => value,
        Err { error: _ } => std::string::empty(),
    }
}

/// EFFECT: open a connection and complete its handshake — the one call most
/// programs want.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::connect("127.0.0.1", 5432, "postgres", "app", "", 30000);
/// ```
pub fn connect(in host: Str, take port: Int, in user: Str, in database: Str, in password: Str, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let opened = open(host, port, timeout_ms);
    if !is_ok_int(opened) {
        return Err { error: unwrap_err_int(opened) };
    }
    let fd = unwrap_ok_int(opened);

    let shook = handshake(fd, user, database, password, timeout_ms);
    if !is_ok_int(shook) {
        // Do not leak the descriptor when the handshake fails.
        let _ = close(fd);
        return Err { error: unwrap_err_int(shook) };
    }
    Ok { value: fd }
}

// ----------------------------------------------------------------------------
// Turning an ErrorResponse into a typed error.
// ----------------------------------------------------------------------------

/// Build a `PgError` from an `ErrorResponse` payload, preserving the server's
/// message and SQLSTATE.
///
/// Pure (it only reads bytes), so it is spec-checked below against a real
/// error payload.
///
/// # Example
/// ```tuo
/// // let e = pg::conn::error_from_payload(payload);
/// ```
pub fn error_from_payload(in payload: String) -> db::error::PgError {
    let msg = pg::message::error_field(payload, pg::message::field_message());
    let state = pg::message::error_field(payload, pg::message::field_sqlstate());
    db::error::server(std::string::as_str(msg), std::string::as_str(state))
}

// ----------------------------------------------------------------------------
// Specs — the pure parts only. Everything effectful above is pinned by
// `examples/live_check.tuo` against a real server instead (`R0007`).
// ----------------------------------------------------------------------------

/// Spec helper: the kind of the error built from a fixture ErrorResponse.
pub fn fixture_error_kind() -> Int {
    db::error::kind(error_from_payload(pg::message::fixture_error()))
}

/// Spec helper: the SQLSTATE carried through from a fixture ErrorResponse.
pub fn fixture_error_sqlstate_is(in expect: Str) -> Bool {
    std::string::as_str(db::error::sqlstate(error_from_payload(pg::message::fixture_error()))) == expect
}

/// Spec helper: the message carried through from a fixture ErrorResponse.
pub fn fixture_error_message_is(in expect: Str) -> Bool {
    std::string::as_str(db::error::message(error_from_payload(pg::message::fixture_error()))) == expect
}

spec is_open {
    then is_open(0);
    then is_open(3);
    then !is_open(0 - 1);
    then !is_open(timeout_sentinel());
}

spec error_from_payload {
    // A server error keeps its kind, its SQLSTATE, and its text — the three
    // things a caller needs to act, match, and report.
    then fixture_error_kind() == db::error::kind_server();
    then fixture_error_sqlstate_is("42601");
    then fixture_error_message_is("syntax error at or near \"SELCT\"");
}

spec default_port {
    then default_port() == 5432;
}
