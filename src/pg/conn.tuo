// pg::conn — the socket: connecting, reading framed messages, writing them.
//
// This is the adapter's **effect tier**. Everything below touches the network,
// so — by the same rule `tuo-stdlib` follows — none of it can appear in a spec
// (`R0007`); it is pinned instead by the live integration program in
// `examples/live_check.tuo`, which runs against a real server. The pure tiers
// (`db::bytes`, `pg::proto`, `pg::message`, `pg::value`, `pg::auth`) carry the
// specs, and they carry the logic worth proving.
//
// A CONNECTION IS AN INT.
//
// v0 has no destructors, so a connection cannot be an object that closes
// itself. It is what the OS calls it: a **descriptor**,
// an `Int`, which the caller passes back to every function here and eventually
// hands to `close`. That is honest about the lifetime — nothing pretends to
// manage it — and it costs nothing at runtime.
//
// EVERY WAIT IS BOUNDED.
//
// Every read and the connect itself take a timeout in milliseconds and go
// through ADR-0017's bounded-wait primitives. A database client that blocks
// forever on a peer that has gone away is not a client, it is a hang; the
// blocking forms are deliberately never used here. A timeout reports `-3`,
// which the seam keeps distinct from end-of-input (`-1`) and host error
// (`-2`), so "the server is slow" never gets confused with "the server is
// gone".
//
// A LOST CONNECTION IS CLOSED HERE, NOT LEFT FOR THE CALLER.
//
// After a timeout or a failed read or write, nobody can say where the stream
// stands: the reply may still be on its way, or half of it may already have
// been consumed. A descriptor in that state is worse than a closed one — the
// next query would read the previous query's rows as its own. So every path
// that gives up on the stream goes through `lose`, which closes the
// descriptor and marks the error (`db::error::is_fatal`) so the caller knows
// not to touch it again. A server error is not that: the stream is drained
// to `ReadyForQuery` and the connection stays usable.
//
// READING IS BYTE-AT-A-TIME.
//
// The seam offers `read_byte`, so a message is assembled one byte at a time
// into an owned `String`. That is the only shape available in v0, and for a
// length-prefixed protocol it is exactly sufficient: read five header bytes,
// decode the length, then read precisely that many more. There is no
// over-read, so no buffer to manage and no way to desynchronize the stream.

module pg::conn;

// ----------------------------------------------------------------------------
// Sentinels and defaults.
// ----------------------------------------------------------------------------

/// The default port PostgreSQL listens on.
pub fn default_port() -> Int {
    5432
}

/// A sensible default timeout for a read or a connect: 30 seconds.
pub fn default_timeout_ms() -> Int {
    30000
}

/// The seam's timeout sentinel (ADR-0017).
pub fn timeout_sentinel() -> Int {
    0 - 3
}

/// The seam's end-of-input sentinel.
pub fn eof_sentinel() -> Int {
    0 - 1
}

/// Is `outcome` a usable descriptor?
///
/// # Example
/// ```tuo
/// let ok = pg::conn::is_open(3); // true
/// ```
pub fn is_open(take outcome: Int) -> Bool {
    outcome >= 0
}

// ----------------------------------------------------------------------------
// Opening and closing.
// ----------------------------------------------------------------------------

/// EFFECT: open a TCP connection to `host:port`, waiting at most
/// `timeout_ms`.
///
/// `host` must be a **numeric** address — `"127.0.0.1"` or `"::1"` — because
/// v0 has no DNS (ADR-0017 leaves name resolution to be written in tuonelang
/// on its UDP primitives). The address family is inferred from the literal, so
/// IPv6 works with no separate spelling.
///
/// Returns the descriptor, or a typed error distinguishing a timeout from a
/// refused connection — the two an operator diagnoses differently.
///
/// # Example
/// ```tuo
/// // let c = pg::conn::open("127.0.0.1", 5432, 5000);
/// ```
pub fn open(in host: Str, take port: Int, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let fd = std::rt::connect_timeout(host, port, timeout_ms);
    if fd == timeout_sentinel() {
        var m = std::string::empty();
        std::string::append(m, "timed out connecting to ");
        std::string::append(m, host);
        return Err { error: db::error::new(db::error::kind_timeout(), std::string::as_str(m)) };
    }
    if fd < 0 {
        var m = std::string::empty();
        std::string::append(m, "could not connect to ");
        std::string::append(m, host);
        std::string::append(m, " (is the server running and reachable?)");
        return Err { error: db::error::new(db::error::kind_connection(), std::string::as_str(m)) };
    }
    Ok { value: fd }
}

/// EFFECT: close a connection's descriptor. Safe to call on an error path.
///
/// # Example
/// ```tuo
/// // let _ = pg::conn::close(fd);
/// ```
pub fn close(take fd: Int) -> Int {
    std::rt::close(fd)
}

/// EFFECT: send `Terminate` and close — the courteous disconnect, which lets
/// the server release the backend immediately rather than waiting for the
/// socket to drop.
///
/// # Example
/// ```tuo
/// // let _ = pg::conn::shutdown(fd);
/// ```
pub fn shutdown(take fd: Int) -> Int {
    let _ = write_message(fd, pg::proto::terminate());
    close(fd)
}

// ----------------------------------------------------------------------------
// Writing.
// ----------------------------------------------------------------------------

/// EFFECT: write a complete encoded message to the socket.
///
/// Returns the number of bytes written, or a negative host error.
///
/// # Example
/// ```tuo
/// // let n = pg::conn::write_message(fd, pg::proto::query("SELECT 1"));
/// ```
pub fn write_message(take fd: Int, in msg: String) -> Int {
    std::rt::write_string(fd, msg)
}

/// EFFECT: write a message and classify the outcome as a typed error.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::send(fd, pg::proto::sync());
/// ```
pub fn send(take fd: Int, in msg: String) -> Result[Int, db::error::PgError] {
    let n = write_message(fd, msg);
    if n < 0 {
        return Err { error: lose(fd, db::error::new(db::error::kind_connection(), "the connection failed while sending (the server may have closed it)")) };
    }
    Ok { value: n }
}

// ----------------------------------------------------------------------------
// Giving up on a connection.
// ----------------------------------------------------------------------------

/// The text every fatal error ends with, so a log line says the descriptor
/// is gone without the reader having to know the kind rule.
pub fn closed_suffix() -> Str {
    "; the connection has been closed and the descriptor must not be used again"
}

/// `e` with `closed_suffix` appended to its message; kind and SQLSTATE are
/// kept. Pure, so the shape of every fatal error is spec-checked.
///
/// # Example
/// ```tuo
/// let e = pg::conn::mark_closed(db::error::new(db::error::kind_timeout(), "slow"));
/// ```
pub fn mark_closed(in e: db::error::PgError) -> db::error::PgError {
    var m = db::error::message(e);
    std::string::append(m, closed_suffix());
    db::error::with_sqlstate(db::error::kind(e), std::string::as_str(m), std::string::as_str(db::error::sqlstate(e)))
}

/// The error to report when a read failed after the server had already sent
/// an `ErrorResponse` — as it does before closing a connection it is
/// terminating (`57P01`). The server's own words and SQLSTATE are what the
/// caller should see, as a `kind_connection` since the descriptor is gone;
/// a timeout after a server error is still reported as a timeout, because
/// then the server did not close anything.
///
/// # Example
/// ```tuo
/// // let e = pg::conn::lost_after(read_error, recorded, had_recorded);
/// ```
pub fn lost_after(in read_error: db::error::PgError, in recorded: db::error::PgError, take had_recorded: Bool) -> db::error::PgError {
    if had_recorded && db::error::kind(read_error) == db::error::kind_connection() {
        db::error::with_sqlstate(db::error::kind_connection(), std::string::as_str(db::error::message(recorded)), std::string::as_str(db::error::sqlstate(recorded)))
    } else {
        db::error::with_sqlstate(db::error::kind(read_error), std::string::as_str(db::error::message(read_error)), std::string::as_str(db::error::sqlstate(read_error)))
    }
}

/// EFFECT: close `fd` and return `e` marked closed — the one exit for every
/// error after which the stream's position is unknown.
///
/// Closing is the only honest move: v0 has no destructors and a connection is
/// a bare `Int`, so there is nowhere to hang a "broken" flag, and a descriptor
/// left open would hand the *next* query the previous one's reply. The caller
/// sees `db::error::is_fatal` and reconnects; it must not `shutdown` or
/// `close` the descriptor itself, because the number may already belong to
/// something else.
///
/// # Example
/// ```tuo
/// // return Err { error: pg::conn::lose(fd, e) };
/// ```
pub fn lose(take fd: Int, in e: db::error::PgError) -> db::error::PgError {
    let _ = close(fd);
    mark_closed(e)
}

// ----------------------------------------------------------------------------
// Reading.
//
// The header/payload split is what makes framing impossible to get wrong: the
// length is read before any payload byte, so the reader always knows exactly
// how many bytes belong to this message.
// ----------------------------------------------------------------------------

/// EFFECT: read exactly `count` bytes into a new owned `String`.
///
/// Returns a typed error on timeout, end of input, or host error — each
/// distinguished, because a truncated message and a slow one need different
/// responses.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::read_exact(fd, 5, 30000);
/// ```
pub fn read_exact(take fd: Int, take count: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    var out = std::string::empty();
    var i = 0;
    while i < count {
        let b = std::rt::read_byte_timeout(fd, timeout_ms);
        if b == timeout_sentinel() {
            return Err { error: db::error::new(db::error::kind_timeout(), "timed out waiting for the server to send more data") };
        }
        if b == eof_sentinel() {
            return Err { error: db::error::new(db::error::kind_connection(), "the server closed the connection mid-message") };
        }
        if b < 0 {
            return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while receiving") };
        }
        std::string::push_byte(out, b);
        i = i + 1;
    }
    Ok { value: out }
}

/// EFFECT: read one complete backend message, returning its **type byte**.
///
/// The payload is returned separately by `read_message_payload`; this pair
/// exists because v0 has no tuples and no generic pair type that would let one
/// call return both. In practice the caller reads the type, branches on it,
/// and reads the payload — which is the natural shape anyway.
///
/// Use `read_message` for the combined form.
///
/// # Example
/// ```tuo
/// // let t = pg::conn::read_type(fd, 30000);
/// ```
pub fn read_type(take fd: Int, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    match read_exact(fd, 1, timeout_ms) {
        Ok { value } => Ok { value: std::string::byte_at(value, 0) },
        Err { error } => Err { error: error },
    }
}

/// EFFECT: read a message's payload, given that its type byte was already
/// consumed.
///
/// Reads the Int32 length, subtracts the four bytes the length field itself
/// occupies, and reads exactly that many payload bytes.
///
/// A length below 4 is a protocol violation (it would claim the message is
/// shorter than its own header), and is reported rather than used to compute a
/// negative read count.
///
/// # Example
/// ```tuo
/// // let p = pg::conn::read_message_payload(fd, 30000);
/// ```
pub fn read_message_payload(take fd: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    match read_exact(fd, 4, timeout_ms) {
        Ok { value } => read_body_of_length(fd, db::bytes::be_i32(value, 0), timeout_ms),
        Err { error } => Err { error: error },
    }
}

/// EFFECT: read the payload of a message whose declared length is `len`.
///
/// Split out of `read_message_payload` so the length check is a named step
/// rather than a block inside a `match` arm.
///
/// A length below 4 would claim the message is shorter than its own header, so
/// it is a protocol violation rather than a read count.
pub fn read_body_of_length(take fd: Int, take len: Int, take timeout_ms: Int) -> Result[String, db::error::PgError] {
    if len < 4 {
        return Err { error: db::error::new(db::error::kind_protocol(), "the server declared a message length below the 4-byte minimum") };
    }
    read_exact(fd, len - 4, timeout_ms)
}

// ----------------------------------------------------------------------------
// The handshake.
// ----------------------------------------------------------------------------

/// EFFECT: perform the startup handshake on an open descriptor.
///
/// Sends the startup packet, then consumes messages until the server either
/// authenticates the connection (`ReadyForQuery`) or refuses it. Along the way
/// it absorbs the `ParameterStatus` and `BackendKeyData` messages every server
/// sends, which must be drained or they desynchronize the next query.
///
/// Authentication is decided and computed by `pg::auth`; this function only
/// moves the bytes. Trust, cleartext, and `md5` are one reply each
/// (`respond_to_auth`). SCRAM-SHA-256 is three server messages, so its state
/// — the client's first message and the signature the server must answer
/// with — lives across this loop, and `scram_next_stage` refuses any message
/// that arrives out of order, including an `AuthenticationOk` from a server
/// that skipped proving itself.
///
/// The time spent *computing* a SCRAM proof is not covered by `timeout_ms`,
/// which bounds each wait on the socket; `pg::auth::scram_max_iterations`
/// is what bounds the computation.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::handshake(fd, "postgres", "app", "", 30000);
/// ```
pub fn handshake(take fd: Int, in user: Str, in database: Str, in password: Str, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let sent = write_message(fd, pg::proto::startup(user, database));
    if sent < 0 {
        return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while sending the startup packet") };
    }

    // SCRAM spans three server messages; this is what carries over.
    var scram_stage = scram_idle();
    var scram_bare = std::string::empty();
    var scram_expect = std::string::empty();

    // Bound the exchange so a misbehaving peer cannot spin this loop forever.
    var guard = 0;
    while guard < 1000 {
        guard = guard + 1;

        // Read one message: type byte, then payload.
        let type_result = read_type(fd, timeout_ms);
        if !is_ok_int(type_result) {
            return Err { error: unwrap_err_int(type_result) };
        }
        let type_byte = unwrap_ok_int(type_result);

        let payload_result = read_message_payload(fd, timeout_ms);
        if !is_ok_string(payload_result) {
            return Err { error: unwrap_err_string(payload_result) };
        }
        let payload = unwrap_ok_string(payload_result);

        if type_byte == pg::proto::be_error_response() {
            return Err { error: error_from_payload(payload) };
        }

        if type_byte == pg::proto::be_authentication() {
            let k = pg::message::auth_kind(payload);
            let next = scram_next_stage(scram_stage, k);
            if next < 0 {
                return Err { error: out_of_order_error(k) };
            }
            if k == pg::proto::auth_sasl() {
                let began = scram_begin(fd, payload);
                if !is_ok_string(began) {
                    return Err { error: unwrap_err_string(began) };
                }
                scram_bare = unwrap_ok_string(began);
            } else if k == pg::proto::auth_sasl_continue() {
                let answered = scram_continue(fd, payload, password, std::string::as_str(scram_bare));
                if !is_ok_string(answered) {
                    return Err { error: unwrap_err_string(answered) };
                }
                scram_expect = unwrap_ok_string(answered);
            } else if k == pg::proto::auth_sasl_final() {
                let body = pg::message::auth_sasl_body(payload);
                if !pg::auth::scram_server_ok(std::string::as_str(body), std::string::as_str(scram_expect)) {
                    return Err { error: pg::auth::scram_server_error() };
                }
            } else {
                let outcome = respond_to_auth(fd, payload, user, password);
                if outcome != auth_continue() {
                    return Err { error: auth_outcome_error(outcome, k) };
                }
            }
            scram_stage = next;
        } else if type_byte == pg::proto::be_ready_for_query() {
            // The handshake is complete; report the transaction status.
            return Ok { value: pg::message::tx_status(payload) };
        }
    // ParameterStatus, BackendKeyData, and NoticeResponse are absorbed:
    // they carry useful information but nothing the handshake must act on.
    }

    Err { error: db::error::new(db::error::kind_protocol(), "the server sent too many messages without completing the handshake") }
}

/// `respond_to_auth`: the exchange may continue.
pub fn auth_continue() -> Int {
    0
}

/// `respond_to_auth`: the demanded method cannot be performed.
pub fn auth_refused() -> Int {
    1
}

/// `respond_to_auth`: the method is fine, but the answer could not be sent.
pub fn auth_send_failed() -> Int {
    2
}

/// `respond_to_auth`: the request itself was malformed (an `md5` request
/// without its salt).
pub fn auth_malformed() -> Int {
    3
}

/// EFFECT: answer one single-reply `AuthenticationRequest` — ok, cleartext,
/// or `md5`. Returns `auth_continue` when the exchange may go on,
/// `auth_refused` when the demanded method cannot be performed,
/// `auth_send_failed` when the answer could not be written, and
/// `auth_malformed` when the request was not well-formed.
///
/// They are kept apart because they call for different fixes: a refused
/// method is a `pg_hba.conf` matter, a failed write means the socket is gone
/// — and reporting the second as the first would send an operator to the
/// wrong place.
///
/// SCRAM is not answered here: it is a conversation, not a reply, and
/// `handshake` drives it through `scram_begin` and `scram_continue`.
pub fn respond_to_auth(take fd: Int, in payload: String, in user: Str, in password: Str) -> Int {
    let k = pg::message::auth_kind(payload);
    let p = pg::auth::plan(k);
    if p == pg::auth::plan_ok() {
        // Authenticated; the caller keeps draining until ReadyForQuery.
        auth_continue()
    } else if p == pg::auth::plan_cleartext() {
        send_password(fd, password)
    } else if p == pg::auth::plan_md5() {
        send_md5(fd, pg::auth::md5_response(password, user, pg::message::auth_md5_salt(payload)))
    } else {
        // Kerberos / GSSAPI / SSPI — refused with a typed error by the
        // caller, which has the auth kind to name it.
        auth_refused()
    }
}

/// EFFECT: send a `PasswordMessage` carrying `secret` — the password itself
/// under cleartext, its salted digest under `md5`.
pub fn send_password(take fd: Int, in secret: Str) -> Int {
    let n = write_message(fd, pg::proto::password(secret));
    if n < 0 {
        auth_send_failed()
    } else {
        auth_continue()
    }
}

/// EFFECT: send an `md5` digest, or report the request that could not be
/// answered as malformed.
pub fn send_md5(take fd: Int, take response: Result[String, db::error::PgError]) -> Int {
    match response {
        Ok { value } => send_password(fd, std::string::as_str(value)),
        Err { error: _ } => auth_malformed(),
    }
}

/// The error for a `respond_to_auth` outcome that ended the handshake.
///
/// Pure, so the mapping is spec-checked: a refusal is `kind_auth` naming the
/// method and the fix, a failed send is `kind_connection`, a malformed
/// request is `kind_protocol`.
///
/// # Example
/// ```tuo
/// let e = pg::conn::auth_outcome_error(pg::conn::auth_refused(), 5);
/// ```
pub fn auth_outcome_error(take outcome: Int, take auth_kind: Int) -> db::error::PgError {
    if outcome == auth_send_failed() {
        db::error::new(db::error::kind_connection(), "the connection failed while sending the password")
    } else if outcome == auth_malformed() {
        db::error::new(db::error::kind_protocol(), "the server's authentication request was malformed")
    } else {
        pg::auth::unsupported_error(auth_kind)
    }
}

// ----------------------------------------------------------------------------
// SCRAM-SHA-256: the conversation. The cryptography is `pg::auth`'s.
// ----------------------------------------------------------------------------

/// No SCRAM exchange is under way.
pub fn scram_idle() -> Int {
    0
}

/// The client-first message has been sent; the server's first is awaited.
pub fn scram_sent_first() -> Int {
    1
}

/// The client's proof has been sent; the server's signature is awaited.
pub fn scram_sent_final() -> Int {
    2
}

/// The server's signature has been checked; only `AuthenticationOk` remains.
pub fn scram_verified() -> Int {
    3
}

/// The stage an authentication message of `auth_kind` moves a handshake at
/// `stage` to, or `-1` when that message may not arrive there.
///
/// This is the whole ordering rule of the handshake, pure so it is
/// spec-checked. The line that matters most: `AuthenticationOk` is refused
/// while a SCRAM exchange is unfinished, because a server that skips its
/// final message has not shown that it knows the password — and that proof
/// is the only thing standing between a client and an impostor.
///
/// # Example
/// ```tuo
/// let s = pg::conn::scram_next_stage(pg::conn::scram_idle(), pg::proto::auth_sasl()); // scram_sent_first()
/// ```
pub fn scram_next_stage(take stage: Int, take auth_kind: Int) -> Int {
    if auth_kind == pg::proto::auth_sasl() {
        if stage == scram_idle() {
            scram_sent_first()
        } else {
            0 - 1
        }
    } else if auth_kind == pg::proto::auth_sasl_continue() {
        if stage == scram_sent_first() {
            scram_sent_final()
        } else {
            0 - 1
        }
    } else if auth_kind == pg::proto::auth_sasl_final() {
        if stage == scram_sent_final() {
            scram_verified()
        } else {
            0 - 1
        }
    } else if stage == scram_idle() || stage == scram_verified() && auth_kind == pg::proto::auth_ok() {
        // Outside an exchange anything may be asked; after one, only Ok.
        stage
    } else {
        0 - 1
    }
}

/// The error for an authentication message that arrived out of order.
///
/// An `AuthenticationOk` cutting a SCRAM exchange short is an authentication
/// failure — the server never proved itself; anything else is a protocol
/// violation.
///
/// # Example
/// ```tuo
/// let e = pg::conn::out_of_order_error(pg::proto::auth_ok());
/// ```
pub fn out_of_order_error(take auth_kind: Int) -> db::error::PgError {
    if auth_kind == pg::proto::auth_ok() {
        pg::auth::scram_server_error()
    } else {
        db::error::new(db::error::kind_protocol(), "the server sent its authentication messages out of order")
    }
}

/// EFFECT: open a SCRAM exchange in answer to `AuthenticationSASL`. Draws
/// the client nonce, sends the `SASLInitialResponse`, and returns the
/// client-first-message-bare the rest of the exchange is computed over.
///
/// Refused when the server does not offer plain `SCRAM-SHA-256`, or when
/// the platform has no entropy for a nonce.
pub fn scram_begin(take fd: Int, in payload: String) -> Result[String, db::error::PgError] {
    if !pg::auth::offers_scram(pg::message::auth_sasl_body(payload)) {
        return Err { error: pg::auth::auth_error("the server offered no SASL mechanism this adapter speaks; it needs SCRAM-SHA-256 without channel binding") };
    }
    let nonce = std::crypto::base64_encode(std::crypto::nonce(pg::auth::scram_nonce_bytes()));
    let first = pg::auth::scram_client_first(std::string::as_str(nonce));
    if !is_ok_string(first) {
        return Err { error: unwrap_err_string(first) };
    }
    let message = unwrap_ok_string(first);
    let n = write_message(fd, pg::proto::sasl_initial(pg::auth::scram_mechanism(), std::string::as_str(message)));
    if n < 0 {
        return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while sending the SCRAM client-first message") };
    }
    Ok { value: pg::auth::scram_client_first_bare(std::string::as_str(nonce)) }
}

/// EFFECT: answer `AuthenticationSASLContinue`. Computes the proof, sends
/// it, and returns the signature the server's final message must carry.
pub fn scram_continue(take fd: Int, in payload: String, in password: Str, in client_first_bare: Str) -> Result[String, db::error::PgError] {
    let body = pg::message::auth_sasl_body(payload);
    match pg::auth::scram_respond(password, client_first_bare, std::string::as_str(body)) {
        Ok { value } => scram_send_final(fd, value),
        Err { error } => Err { error: error },
    }
}

/// EFFECT: send the client-final message of `exchange`; the second half of
/// `scram_continue`.
pub fn scram_send_final(take fd: Int, in exchange: pg::auth::Scram) -> Result[String, db::error::PgError] {
    let message = pg::auth::scram_client_final(exchange);
    let n = write_message(fd, pg::proto::sasl_response(std::string::as_str(message)));
    if n < 0 {
        return Err { error: db::error::new(db::error::kind_connection(), "the connection failed while sending the SCRAM proof") };
    }
    Ok { value: pg::auth::scram_server_signature(exchange) }
}

// ----------------------------------------------------------------------------
// Result helpers.
//
// The "inspect, then act" shape a protocol loop needs is expressed with these
// small named projections: each borrows, so a result can be inspected and
// still unwrapped afterwards, where a `match` on the owned value would move
// it.
// ----------------------------------------------------------------------------

/// Is this `Result[Int, PgError]` an `Ok`? Borrows rather than consumes, so
/// the caller can inspect a result and still unwrap it afterwards — a `match`
/// on an owned value moves it (`O0001`).
pub fn is_ok_int(in r: Result[Int, db::error::PgError]) -> Bool {
    match r {
        Ok { value: _ } => true,
        Err { error: _ } => false,
    }
}

/// The value of a successful `Result[Int, PgError]`, or `-1`.
pub fn unwrap_ok_int(in r: Result[Int, db::error::PgError]) -> Int {
    match r {
        // `Int` is Copy, so reading it out of a borrow is a copy, not a move.
        Ok { value } => value,
        Err { error: _ } => 0 - 1,
    }
}

/// Is this `Result[String, PgError]` an `Ok`?
pub fn is_ok_string(in r: Result[String, db::error::PgError]) -> Bool {
    match r {
        Ok { value: _ } => true,
        Err { error: _ } => false,
    }
}

/// The error of a failed `Result[Int, PgError]`, or a protocol error when it
/// was actually `Ok` (which the callers above never do).
pub fn unwrap_err_int(take r: Result[Int, db::error::PgError]) -> db::error::PgError {
    match r {
        Ok { value: _ } => db::error::new(db::error::kind_protocol(), "expected an error"),
        Err { error } => error,
    }
}

/// The error of a failed `Result[String, PgError]`.
pub fn unwrap_err_string(take r: Result[String, db::error::PgError]) -> db::error::PgError {
    match r {
        Ok { value: _ } => db::error::new(db::error::kind_protocol(), "expected an error"),
        Err { error } => error,
    }
}

/// The value of a successful `Result[String, PgError]`, or the empty string.
pub fn unwrap_ok_string(take r: Result[String, db::error::PgError]) -> String {
    match r {
        Ok { value } => value,
        Err { error: _ } => std::string::empty(),
    }
}

/// EFFECT: open a connection and complete its handshake — the one call most
/// programs want.
///
/// # Example
/// ```tuo
/// // let r = pg::conn::connect("127.0.0.1", 5432, "postgres", "app", "", 30000);
/// ```
pub fn connect(in host: Str, take port: Int, in user: Str, in database: Str, in password: Str, take timeout_ms: Int) -> Result[Int, db::error::PgError] {
    let opened = open(host, port, timeout_ms);
    if !is_ok_int(opened) {
        return Err { error: unwrap_err_int(opened) };
    }
    let fd = unwrap_ok_int(opened);

    let shook = handshake(fd, user, database, password, timeout_ms);
    if !is_ok_int(shook) {
        // Do not leak the descriptor when the handshake fails.
        let _ = close(fd);
        return Err { error: unwrap_err_int(shook) };
    }
    Ok { value: fd }
}

// ----------------------------------------------------------------------------
// Turning an ErrorResponse into a typed error.
// ----------------------------------------------------------------------------

/// Build a `PgError` from an `ErrorResponse` payload, preserving the server's
/// message and SQLSTATE.
///
/// Pure (it only reads bytes), so it is spec-checked below against a real
/// error payload.
///
/// # Example
/// ```tuo
/// // let e = pg::conn::error_from_payload(payload);
/// ```
pub fn error_from_payload(in payload: String) -> db::error::PgError {
    let msg = pg::message::error_field(payload, pg::message::field_message());
    let state = pg::message::error_field(payload, pg::message::field_sqlstate());
    db::error::server(std::string::as_str(msg), std::string::as_str(state))
}

// ----------------------------------------------------------------------------
// Specs — the pure parts only. Everything effectful above is pinned by
// `examples/live_check.tuo` against a real server instead (`R0007`).
// ----------------------------------------------------------------------------

/// Spec helper: the kind of the error built from a fixture ErrorResponse.
pub fn fixture_error_kind() -> Int {
    db::error::kind(error_from_payload(pg::message::fixture_error()))
}

/// Spec helper: the SQLSTATE carried through from a fixture ErrorResponse.
pub fn fixture_error_sqlstate_is(in expect: Str) -> Bool {
    std::string::as_str(db::error::sqlstate(error_from_payload(pg::message::fixture_error()))) == expect
}

/// Spec helper: the message carried through from a fixture ErrorResponse.
pub fn fixture_error_message_is(in expect: Str) -> Bool {
    std::string::as_str(db::error::message(error_from_payload(pg::message::fixture_error()))) == expect
}

spec is_open {
    then is_open(0);
    then is_open(3);
    then !is_open(0 - 1);
    then !is_open(timeout_sentinel());
}

spec error_from_payload {
    // A server error keeps its kind, its SQLSTATE, and its text — the three
    // things a caller needs to act, match, and report.
    then fixture_error_kind() == db::error::kind_server();
    then fixture_error_sqlstate_is("42601");
    then fixture_error_message_is("syntax error at or near \"SELCT\"");
}

spec default_port {
    then default_port() == 5432;
}

/// Spec helper: the kind of a marked-closed error of kind `k`.
pub fn closed_kind(take k: Int) -> Int {
    db::error::kind(mark_closed(db::error::new(k, "x")))
}

/// Spec helper: the message of a marked-closed timeout.
pub fn closed_message_is(in expect: Str) -> Bool {
    std::string::as_str(db::error::message(mark_closed(db::error::new(db::error::kind_timeout(), "slow")))) == expect
}

/// Spec helper: the kind `lost_after` reports for a read error of `read_kind`
/// when a `57P01` was (or was not) recorded first.
pub fn lost_after_kind(take read_kind: Int, take had: Bool) -> Int {
    db::error::kind(lost_after(db::error::new(read_kind, "r"), db::error::server("gone", "57P01"), had))
}

/// Spec helper: the SQLSTATE `lost_after` reports in the same situation.
pub fn lost_after_state_is(take read_kind: Int, take had: Bool, in expect: Str) -> Bool {
    std::string::as_str(db::error::sqlstate(lost_after(db::error::new(read_kind, "r"), db::error::server("gone", "57P01"), had))) == expect
}

spec mark_closed {
    // The kind survives, the message says the descriptor is gone, and the
    // result is what `is_fatal` recognizes.
    then closed_kind(db::error::kind_timeout()) == db::error::kind_timeout();
    then closed_kind(db::error::kind_connection()) == db::error::kind_connection();
    then closed_message_is("slow; the connection has been closed and the descriptor must not be used again");
    then db::error::is_fatal(mark_closed(db::error::new(db::error::kind_timeout(), "x")));
}

spec lost_after {
    // A server that announced why it was closing is reported in its own
    // words, with its SQLSTATE, as a connection error.
    then lost_after_kind(db::error::kind_connection(), true) == db::error::kind_connection();
    then lost_after_state_is(db::error::kind_connection(), true, "57P01");
    // No announcement: the read error stands as it was.
    then lost_after_state_is(db::error::kind_connection(), false, "");
    // A timeout is a timeout, whatever was recorded before it.
    then lost_after_kind(db::error::kind_timeout(), true) == db::error::kind_timeout();
    then lost_after_state_is(db::error::kind_timeout(), true, "");
}

spec auth_outcome_error {
    // A refused method is an auth error; a failed send is a connection
    // error, never an "unsupported cleartext" one.
    then db::error::kind(auth_outcome_error(auth_refused(), pg::proto::auth_kerberos())) == db::error::kind_auth();
    then db::error::kind(auth_outcome_error(auth_send_failed(), pg::proto::auth_cleartext())) == db::error::kind_connection();
    then db::error::kind(auth_outcome_error(auth_malformed(), pg::proto::auth_md5())) == db::error::kind_protocol();
    // The outcomes are distinct.
    then auth_continue() != auth_refused();
    then auth_refused() != auth_send_failed();
    then auth_send_failed() != auth_malformed();
}

spec scram_next_stage {
    // The one legal path through an exchange.
    then scram_next_stage(scram_idle(), pg::proto::auth_sasl()) == scram_sent_first();
    then scram_next_stage(scram_sent_first(), pg::proto::auth_sasl_continue()) == scram_sent_final();
    then scram_next_stage(scram_sent_final(), pg::proto::auth_sasl_final()) == scram_verified();
    then scram_next_stage(scram_verified(), pg::proto::auth_ok()) == scram_verified();
    // With no exchange under way, the single-reply methods pass through.
    then scram_next_stage(scram_idle(), pg::proto::auth_ok()) == scram_idle();
    then scram_next_stage(scram_idle(), pg::proto::auth_cleartext()) == scram_idle();
    then scram_next_stage(scram_idle(), pg::proto::auth_md5()) == scram_idle();
    // A server may not declare success before proving itself.
    then scram_next_stage(scram_sent_first(), pg::proto::auth_ok()) == 0 - 1;
    then scram_next_stage(scram_sent_final(), pg::proto::auth_ok()) == 0 - 1;
    // Nor skip, repeat, or restart a step.
    then scram_next_stage(scram_idle(), pg::proto::auth_sasl_continue()) == 0 - 1;
    then scram_next_stage(scram_idle(), pg::proto::auth_sasl_final()) == 0 - 1;
    then scram_next_stage(scram_sent_first(), pg::proto::auth_sasl_final()) == 0 - 1;
    then scram_next_stage(scram_sent_first(), pg::proto::auth_sasl()) == 0 - 1;
    then scram_next_stage(scram_verified(), pg::proto::auth_sasl()) == 0 - 1;
    // Nor change its mind and ask for the password in the clear mid-exchange.
    then scram_next_stage(scram_sent_first(), pg::proto::auth_cleartext()) == 0 - 1;
    then scram_next_stage(scram_verified(), pg::proto::auth_cleartext()) == 0 - 1;
    then scram_next_stage(scram_sent_final(), pg::proto::auth_md5()) == 0 - 1;
}

spec out_of_order_error {
    then db::error::kind(out_of_order_error(pg::proto::auth_ok())) == db::error::kind_auth();
    then db::error::kind(out_of_order_error(pg::proto::auth_sasl_final())) == db::error::kind_protocol();
}
