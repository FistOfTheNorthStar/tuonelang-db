// pg::value — PostgreSQL type OIDs and text-format value decoding.
//
// The adapter asks for **text format** for every column (format code 0), so a
// value arrives as its human-readable rendering: `42`, `-1`, `t`, `3.5`,
// `2026-09-01`. That choice is deliberate and worth stating, because binary
// format would be faster:
//
//   * text format is what the *simple* query protocol always returns, so one
//     decoder serves both protocols rather than two;
//   * binary layouts are per-type, version-sensitive, and undocumented for
//     several types, whereas the text rendering is stable and specified; and
//   * decoding text needs no bitwise operations at all. (This was once the
//     decisive reason: v0 had no bitwise operators. ADR-0019 Stage A has
//     since landed them, so it is now a convenience rather than a constraint
//     — the two reasons above are what keep the choice correct.)
//
// Everything here is pure, so every decoder below is spec-checked against the
// exact renderings a real server produces.
//
// NULL is **not** represented here. A NULL column has no bytes at all, so it
// is answered by `pg::message::column_is_null` before any decoder runs —
// keeping "absent" and "empty string" distinct, which SQL requires and which a
// decoder returning a sentinel would blur.

module pg::value;

// ----------------------------------------------------------------------------
// Type OIDs — the stable identifiers in `pg_type`.
//
// These are the values a `RowDescription` reports, and they do not change
// between PostgreSQL versions for the built-in types.
// ----------------------------------------------------------------------------

/// `bool` — OID 16.
pub fn oid_bool() -> Int {
    16
}

/// `bytea` — OID 17.
pub fn oid_bytea() -> Int {
    17
}

/// `char` — OID 18.
pub fn oid_char() -> Int {
    18
}

/// `name` — OID 19.
pub fn oid_name() -> Int {
    19
}

/// `int8` (bigint) — OID 20.
pub fn oid_int8() -> Int {
    20
}

/// `int2` (smallint) — OID 21.
pub fn oid_int2() -> Int {
    21
}

/// `int4` (integer) — OID 23.
pub fn oid_int4() -> Int {
    23
}

/// `text` — OID 25.
pub fn oid_text() -> Int {
    25
}

/// `oid` — OID 26.
pub fn oid_oid() -> Int {
    26
}

/// `json` — OID 114.
pub fn oid_json() -> Int {
    114
}

/// `float4` (real) — OID 700.
pub fn oid_float4() -> Int {
    700
}

/// `float8` (double precision) — OID 701.
pub fn oid_float8() -> Int {
    701
}

/// `varchar` — OID 1043.
pub fn oid_varchar() -> Int {
    1043
}

/// `date` — OID 1082.
pub fn oid_date() -> Int {
    1082
}

/// `time` — OID 1083.
pub fn oid_time() -> Int {
    1083
}

/// `timestamp` — OID 1114.
pub fn oid_timestamp() -> Int {
    1114
}

/// `timestamptz` — OID 1184.
pub fn oid_timestamptz() -> Int {
    1184
}

/// `numeric` — OID 1700.
pub fn oid_numeric() -> Int {
    1700
}

/// `uuid` — OID 2950.
pub fn oid_uuid() -> Int {
    2950
}

/// `jsonb` — OID 3802.
pub fn oid_jsonb() -> Int {
    3802
}

/// `float4[]` (real array) — OID 1021.
pub fn oid_float4_array() -> Int {
    1021
}

/// `float8[]` (double precision array) — OID 1022.
pub fn oid_float8_array() -> Int {
    1022
}

/// pgvector's `vector` type has **no fixed OID**: it is assigned when the
/// extension is installed, so a client learns it by asking. This is the query
/// to run once per connection; `scalar_int` on it gives the OID, or an error
/// when the extension is absent.
///
/// # Example
/// ```tuo
/// let q = pg::value::vector_oid_query();
/// ```
pub fn vector_oid_query() -> Str {
    "SELECT oid FROM pg_type WHERE typname = 'vector'"
}

// ----------------------------------------------------------------------------
// OID classification — what shape a column's text rendering has.
// ----------------------------------------------------------------------------

/// Is this OID an integer type whose text form `as_int` decodes exactly?
///
/// # Example
/// ```tuo
/// let b = pg::value::is_integer(pg::value::oid_int4()); // true
/// ```
pub fn is_integer(take oid: Int) -> Bool {
    oid == oid_int2() || oid == oid_int4() || oid == oid_int8() || oid == oid_oid()
}

/// Is this OID a floating-point or arbitrary-precision numeric type?
///
/// `numeric` is included because its *text* form is a decimal literal like
/// `float8`'s; note that decoding it through `as_float` can lose precision
/// that `numeric` was chosen to preserve, so `as_str` is the lossless choice.
///
/// # Example
/// ```tuo
/// let b = pg::value::is_float(pg::value::oid_float8()); // true
/// ```
pub fn is_float(take oid: Int) -> Bool {
    oid == oid_float4() || oid == oid_float8() || oid == oid_numeric()
}

/// Is this OID a textual type that needs no decoding at all?
///
/// # Example
/// ```tuo
/// let b = pg::value::is_text(pg::value::oid_text()); // true
/// ```
pub fn is_text(take oid: Int) -> Bool {
    oid == oid_text() || oid == oid_varchar() || oid == oid_name() || oid == oid_char() || oid == oid_uuid() || oid == oid_json() || oid == oid_jsonb()
}

/// Is this OID a float array whose text form `as_floats` decodes?
///
/// # Example
/// ```tuo
/// let b = pg::value::is_float_array(pg::value::oid_float8_array()); // true
/// ```
pub fn is_float_array(take oid: Int) -> Bool {
    oid == oid_float4_array() || oid == oid_float8_array()
}

/// Is this OID one of the date/time types? Their text renderings are ISO-8601
/// when `DateStyle` is the default `ISO, MDY`, which the adapter does not
/// change.
///
/// # Example
/// ```tuo
/// let b = pg::value::is_temporal(pg::value::oid_date()); // true
/// ```
pub fn is_temporal(take oid: Int) -> Bool {
    oid == oid_date() || oid == oid_time() || oid == oid_timestamp() || oid == oid_timestamptz()
}

// ----------------------------------------------------------------------------
// Decoders.
// ----------------------------------------------------------------------------

/// Decode a `bool` column: PostgreSQL renders true as `t` and false as `f`.
///
/// Anything else is false, which cannot occur from a conforming server.
///
/// # Example
/// ```tuo
/// let b = pg::value::as_bool("t"); // true
/// ```
pub fn as_bool(in raw: Str) -> Bool {
    std::str::len(raw) == 1 && std::str::byte_at(raw, 0) == 116
}

/// Decode an integer column's text rendering.
///
/// Handles a leading `-` (and a leading `+`, which the server never emits but
/// which costs nothing to accept). Returns `Err` for empty input or any
/// non-digit byte, so a malformed value is a value the caller branches on
/// rather than a silent zero.
///
/// **Out of range is an `Err`, never a trap.** Integer overflow traps in
/// tuonelang, and any text column can carry twenty digits, so the accumulator
/// checks each step before it multiplies and reports "out of range" instead
/// of aborting the process. Every value a PostgreSQL `int8` can hold fits in
/// `Int` (both are 64-bit signed), so this fires only for text or `numeric`.
///
/// The digits are accumulated on the **negative** side: `int8`'s minimum,
/// `-9223372036854775808`, has a magnitude one past what a positive `Int`
/// holds, so accumulating positively and negating at the end would trap on
/// the one legitimate value it must decode.
///
/// # Example
/// ```tuo
/// let n = pg::value::as_int("-42");
/// ```
pub fn as_int(in raw: Str) -> Result[Int, Str] {
    let n = std::str::len(raw);
    if n == 0 {
        return Err { error: "empty integer value" };
    }

    var i = 0;
    var negative = false;
    let first = std::str::byte_at(raw, 0);
    if first == 45 {
        negative = true;
        i = 1;
    } else if first == 43 {
        i = 1;
    }
    if i >= n {
        return Err { error: "integer value has a sign but no digits" };
    }

    // `total` holds the negated magnitude; see the doc comment on overflow.
    var total = 0;
    while i < n {
        let b = std::str::byte_at(raw, i);
        if b < 48 || b > 57 {
            return Err { error: "integer value has a non-digit byte" };
        }
        let d = b - 48;
        // `total * 10 - d` stays in range exactly when `total` is at least
        // `(min + d) / 10`; `/` truncates toward zero, which for a negative
        // quotient is the ceiling this needs.
        if total < (int_min() + d) / 10 {
            return Err { error: "integer value is out of range" };
        }
        total = total * 10 - d;
        i = i + 1;
    }

    if negative {
        Ok { value: total }
    } else if total == int_min() {
        // The one magnitude that fits negatively but not positively.
        Err { error: "integer value is out of range" }
    } else {
        Ok { value: 0 - total }
    }
}

/// The smallest `Int`, `-2^63` — spelled without a literal that would itself
/// overflow.
pub fn int_min() -> Int {
    0 - 9223372036854775807 - 1
}

/// Decode an integer column, falling back to `fallback` when it does not parse.
///
/// The convenience form for the common case where a malformed value cannot
/// happen and a `Result` would only add noise.
///
/// # Example
/// ```tuo
/// let n = pg::value::as_int_or("42", 0); // 42
/// ```
pub fn as_int_or(in raw: Str, take fallback: Int) -> Int {
    match as_int(raw) {
        Ok { value } => value,
        Err { error } => fallback,
    }
}

/// Decode a floating-point column's text rendering into a `Float`.
///
/// Accepts a sign, an integer part, an optional fractional part, and an
/// optional `e`/`E` exponent — the full shape PostgreSQL emits for `float8`.
/// The special renderings `NaN`, `Infinity`, and `-Infinity` are reported as
/// `Err` rather than silently becoming a finite number; a caller that wants
/// them can test `raw` directly. A finite rendering whose exponent exceeds
/// what a double holds decodes to an infinity or to zero, as it would in the
/// server; it never traps.
///
/// # Example
/// ```tuo
/// let f = pg::value::as_float("3.5");
/// ```
pub fn as_float(in raw: Str) -> Result[Float, Str] {
    let n = std::str::len(raw);
    if n == 0 {
        return Err { error: "empty float value" };
    }

    var i = 0;
    var negative = false;
    let first = std::str::byte_at(raw, 0);
    if first == 45 {
        negative = true;
        i = 1;
    } else if first == 43 {
        i = 1;
    }
    if i >= n {
        return Err { error: "float value has a sign but no digits" };
    }

    // Integer part: consume digits, stopping at the first byte that is not
    // one. `scanning` is the loop's own exit flag — v0 has no `break`, so the
    // condition carries it explicitly rather than through an index sentinel.
    var whole = 0.0;
    var saw_digit = false;
    var scanning = true;
    while scanning && i < n {
        let b = std::str::byte_at(raw, i);
        if b < 48 || b > 57 {
            scanning = false;
        } else {
            whole = whole * 10.0 + ((b - 48) as Float);
            saw_digit = true;
            i = i + 1;
        }
    }

    // Fractional part.
    if i < n && std::str::byte_at(raw, i) == 46 {
        i = i + 1;
        var scale = 1.0;
        scanning = true;
        while scanning && i < n {
            let b = std::str::byte_at(raw, i);
            if b < 48 || b > 57 {
                scanning = false;
            } else {
                scale = scale / 10.0;
                whole = whole + ((b - 48) as Float) * scale;
                saw_digit = true;
                i = i + 1;
            }
        }
    }

    if !saw_digit {
        return Err { error: "float value has no digits" };
    }

    // Exponent.
    if i < n {
        let e = std::str::byte_at(raw, i);
        if e != 101 && e != 69 {
            return Err { error: "float value has trailing bytes" };
        }
        i = i + 1;
        if i >= n {
            return Err { error: "float value has an empty exponent" };
        }
        var exp_negative = false;
        let esign = std::str::byte_at(raw, i);
        if esign == 45 {
            exp_negative = true;
            i = i + 1;
        } else if esign == 43 {
            i = i + 1;
        }
        if i >= n {
            return Err { error: "float value has an empty exponent" };
        }
        // The exponent saturates rather than overflowing: anything past a few
        // hundred already takes a double to infinity or zero, so more digits
        // change nothing except whether the accumulator traps.
        var exp = 0;
        while i < n {
            let b = std::str::byte_at(raw, i);
            if b < 48 || b > 57 {
                return Err { error: "float value has a non-digit exponent" };
            }
            if exp < exponent_cap() {
                exp = exp * 10 + (b - 48);
            }
            i = i + 1;
        }
        var k = 0;
        while k < exp {
            if exp_negative {
                whole = whole / 10.0;
            } else {
                whole = whole * 10.0;
            }
            k = k + 1;
        }
    }

    if negative {
        Ok { value: 0.0 - whole }
    } else {
        Ok { value: whole }
    }
}

/// Where `as_float` stops accumulating exponent digits. A double's range is
/// about `1e-324` to `1e308`, so any exponent this large already saturates.
pub fn exponent_cap() -> Int {
    400
}

/// Decode a float column, falling back to `fallback` when it does not parse.
///
/// # Example
/// ```tuo
/// let f = pg::value::as_float_or("3.5", 0.0); // 3.5
/// ```
pub fn as_float_or(in raw: Str, take fallback: Float) -> Float {
    match as_float(raw) {
        Ok { value } => value,
        Err { error } => fallback,
    }
}

// ----------------------------------------------------------------------------
// Float sequences: PostgreSQL arrays and pgvector vectors.
//
// A `float8[]` column renders as `{0.1,0.2,0.3}`; a pgvector `vector` column
// renders as `[0.1,0.2,0.3]`. The two differ only in their brackets, so one
// decoder reads both and two one-line encoders write them. This is the seam
// between the PostgreSQL adapter and the vector store: an embedding stored in
// a table comes out of `as_floats` as the `Array[Float]` that `vec::db::add`
// takes, and a query vector goes into a parameter through `vector_literal`
// or `array_literal`.
// ----------------------------------------------------------------------------

/// Decode a PostgreSQL float array (`{…}`) or pgvector vector (`[…]`) text
/// rendering into an `Array[Float]`.
///
/// Elements are comma-separated and decoded with `as_float`; spaces around
/// them are tolerated. An empty `{}` or `[]` is an empty array. Anything else
/// — a missing or mismatched bracket, a `NULL` element, a nested array, a
/// non-numeric element — is an `Err`, so a malformed embedding never reaches
/// the store as a shorter vector than it was.
///
/// # Example
/// ```tuo
/// let r = pg::value::as_floats("{0.1,0.2,0.3}");
/// ```
pub fn as_floats(in raw: Str) -> Result[Array[Float], Str] {
    let n = std::str::len(raw);
    if n < 2 {
        return Err { error: "float array is too short to be bracketed" };
    }
    let open = std::str::byte_at(raw, 0);
    let close = std::str::byte_at(raw, n - 1);
    // `{` … `}` or `[` … `]`.
    if !((open == 123 && close == 125) || (open == 91 && close == 93)) {
        return Err { error: "float array is not bracketed with {} or []" };
    }
    var out = std::array::empty();
    // The body, with an empty body meaning an empty array.
    var i = 1;
    let end = n - 1;
    if i == end {
        return Ok { value: out };
    }
    while i < end {
        // One element runs to the next comma or the closing bracket.
        var j = i;
        while j < end && std::str::byte_at(raw, j) != 44 {
            j = j + 1;
        }
        var from = i;
        var to = j;
        while from < to && std::str::byte_at(raw, from) == 32 {
            from = from + 1;
        }
        while to > from && std::str::byte_at(raw, to - 1) == 32 {
            to = to - 1;
        }
        if from == to {
            return Err { error: "float array has an empty element" };
        }
        match as_float(std::str::slice(raw, from, to)) {
            Ok { value } => std::array::push(out, value),
            Err { error } => return Err { error: "float array has a non-numeric element" },
        }
        i = j + 1;
    }
    // A trailing comma leaves `i == end` with an element owed.
    if std::str::byte_at(raw, end - 1) == 44 {
        return Err { error: "float array has a trailing comma" };
    }
    Ok { value: out }
}

/// `as_floats`, or an empty array when it does not parse.
///
/// Empty rather than a caller-supplied fallback because an `Array` moved on
/// one branch and dropped on the other has no known state at the join
/// (O0008), and an empty vector is the one value every consumer already
/// rejects: `vec::db::add` refuses it as the wrong width.
///
/// # Example
/// ```tuo
/// let xs = pg::value::as_floats_or_empty("{1.0,2.0}");
/// ```
pub fn as_floats_or_empty(in raw: Str) -> Array[Float] {
    match as_floats(raw) {
        Ok { value } => value,
        Err { error } => std::array::empty(),
    }
}

/// `xs` as the elements of a literal, comma-separated, rendered with
/// `db::text::render_float` — plain decimal, never an exponent.
///
/// # Example
/// ```tuo
/// // let body = pg::value::floats_body(xs); // "0.1,0.2"
/// ```
pub fn floats_body(in xs: Array[Float]) -> String {
    var out = std::string::empty();
    var i = 0;
    let n = std::array::len(xs);
    while i < n {
        if i > 0 {
            std::string::push_byte(out, 44);
        }
        std::string::append(out, std::string::as_str(db::text::render_float(std::array::get(xs, i))));
        i = i + 1;
    }
    out
}

/// `xs` as a PostgreSQL array literal, `{0.1,0.2}`, for a `float8[]` or
/// `float4[]` parameter. Bind it as text and cast in the SQL:
/// `$1::float8[]`.
///
/// # Example
/// ```tuo
/// // let lit = pg::value::array_literal(xs); // "{0.1,0.2}"
/// ```
pub fn array_literal(in xs: Array[Float]) -> String {
    var out = std::string::from_str("{");
    std::string::append(out, std::string::as_str(floats_body(xs)));
    std::string::push_byte(out, 125);
    out
}

/// `xs` as a pgvector literal, `[0.1,0.2]`, for a `vector` parameter. Bind
/// it as text and cast in the SQL: `$1::vector`.
///
/// # Example
/// ```tuo
/// // let lit = pg::value::vector_literal(xs); // "[0.1,0.2]"
/// ```
pub fn vector_literal(in xs: Array[Float]) -> String {
    var out = std::string::from_str("[");
    std::string::append(out, std::string::as_str(floats_body(xs)));
    std::string::push_byte(out, 93);
    out
}

// ----------------------------------------------------------------------------
// Specs — pinned to renderings a real PostgreSQL 16 server emits.
// ----------------------------------------------------------------------------

/// Spec helper: a 3-vector.
pub fn f3(take a: Float, take b: Float, take c: Float) -> Array[Float] {
    var xs = std::array::empty();
    std::array::push(xs, a);
    std::array::push(xs, b);
    std::array::push(xs, c);
    xs
}

/// Spec helper: `as_floats` decoded `raw` to exactly `count` elements.
pub fn floats_len(in raw: Str) -> Int {
    match as_floats(raw) {
        Ok { value } => std::array::len(value),
        Err { error } => 0 - 1,
    }
}

/// Spec helper: element `i` of `as_floats(raw)` is near `expect`.
pub fn floats_at_near(in raw: Str, take i: Int, take expect: Float) -> Bool {
    match as_floats(raw) {
        Ok { value } => db::math::near(std::array::get(value, i), expect),
        Err { error } => false,
    }
}

/// Spec helper: `as_floats` rejected `raw`.
pub fn floats_reject(in raw: Str) -> Bool {
    match as_floats(raw) {
        Ok { value } => false,
        Err { error } => true,
    }
}

/// Spec helper: `array_literal` of a 3-vector as a comparable `Str`.
pub fn array_literal_is(take a: Float, take b: Float, take c: Float, in expect: Str) -> Bool {
    let lit = array_literal(f3(a, b, c));
    std::string::as_str(lit) == expect
}

/// Spec helper: `vector_literal` of a 3-vector as a comparable `Str`.
pub fn vector_literal_is(take a: Float, take b: Float, take c: Float, in expect: Str) -> Bool {
    let lit = vector_literal(f3(a, b, c));
    std::string::as_str(lit) == expect
}

/// Spec helper: a vector survives encode → decode, in both literal forms.
pub fn floats_round_trip(take a: Float, take b: Float, take c: Float) -> Bool {
    let arr = array_literal(f3(a, b, c));
    let vec_lit = vector_literal(f3(a, b, c));
    let back_a = as_floats_or_empty(std::string::as_str(arr));
    let back_v = as_floats_or_empty(std::string::as_str(vec_lit));
    std::array::len(back_a) == 3 && std::array::len(back_v) == 3 && db::math::near(std::array::get(back_a, 0), a) && db::math::near(std::array::get(back_a, 1), b) && db::math::near(std::array::get(back_a, 2), c) && db::math::near(std::array::get(back_v, 2), c)
}

/// Spec helper: the literal of an empty vector.
pub fn empty_literal_is(in expect: Str) -> Bool {
    let lit = array_literal(std::array::empty());
    std::string::as_str(lit) == expect
}

/// Spec helper: `as_int` succeeded with exactly `expect`.
pub fn int_is(in raw: Str, take expect: Int) -> Bool {
    match as_int(raw) {
        Ok { value } => value == expect,
        Err { error } => false,
    }
}

/// Spec helper: `as_int` rejected the input.
pub fn int_rejects(in raw: Str) -> Bool {
    match as_int(raw) {
        Ok { value } => false,
        Err { error } => true,
    }
}

/// Spec helper: the absolute value of a `Float`.
pub fn float_abs(take x: Float) -> Float {
    if x < 0.0 {
        0.0 - x
    } else {
        x
    }
}

/// Spec helper: `as_float` succeeded within a tolerance.
pub fn float_near(in raw: Str, take expect: Float) -> Bool {
    match as_float(raw) {
        Ok { value } => float_abs(value - expect) < 0.000001,
        Err { error } => false,
    }
}

/// Spec helper: `as_float` produced an infinity.
pub fn float_is_infinite(in raw: Str) -> Bool {
    match as_float(raw) {
        Ok { value } => db::math::is_infinite(value),
        Err { error } => false,
    }
}

/// Spec helper: `as_float` rejected the input.
pub fn float_rejects(in raw: Str) -> Bool {
    match as_float(raw) {
        Ok { value } => false,
        Err { error } => true,
    }
}

spec as_bool {
    then as_bool("t");
    then !as_bool("f");
    // Only the exact one-byte rendering is true; nothing else is.
    then !as_bool("true");
    then !as_bool("");
    then !as_bool("T");
}

spec as_int {
    then int_is("0", 0);
    then int_is("1", 1);
    then int_is("42", 42);
    then int_is("-42", 0 - 42);
    then int_is("+7", 7);
    then int_is("1234567890", 1234567890);
    // int8 extremes, which a PostgreSQL bigint really can hold.
    then int_is("9223372036854775807", 9223372036854775807);
    then int_is("-9223372036854775807", 0 - 9223372036854775807);
    // int8's minimum: its magnitude does not fit a positive Int, so this is
    // the value a magnitude-then-negate decoder traps on.
    then int_is("-9223372036854775808", 0 - 9223372036854775807 - 1);
    // One past either end, and far past, are errors — never a trap.
    then int_rejects("9223372036854775808");
    then int_rejects("-9223372036854775809");
    then int_rejects("99999999999999999999");
    // Malformed input is an Err, never a silent zero.
    then int_rejects("");
    then int_rejects("-");
    then int_rejects("+");
    then int_rejects("abc");
    then int_rejects("1.5");
    then int_rejects("12a");
    then int_rejects(" 1");
}

spec as_int_or {
    then as_int_or("42", 0) == 42;
    then as_int_or("bad", 7) == 7;
    then as_int_or("", 0 - 1) == 0 - 1;
    // The fallback contract holds for out-of-range text too.
    then as_int_or("99999999999999999999", 7) == 7;
}

spec as_float {
    then float_near("0", 0.0);
    then float_near("1", 1.0);
    then float_near("3.5", 3.5);
    then float_near("-3.5", 0.0 - 3.5);
    then float_near("0.125", 0.125);
    then float_near("100", 100.0);
    then float_near("1e2", 100.0);
    then float_near("1.5e2", 150.0);
    then float_near("15e-1", 1.5);
    then float_rejects("");
    then float_rejects("abc");
    then float_rejects("1.2.3");
    then float_rejects("1e");
    // The special renderings are reported rather than silently finite.
    then float_rejects("NaN");
    then float_rejects("Infinity");
    // An absurd exponent saturates to infinity or zero instead of trapping.
    then float_is_infinite("1e99999999999999999999");
    then float_near("1e-99999999999999999999", 0.0);
}

spec as_float_or {
    then as_float_or("bad", 0.0) == 0.0;
}

spec is_integer {
    then is_integer(oid_int2());
    then is_integer(oid_int4());
    then is_integer(oid_int8());
    then !is_integer(oid_text());
    then !is_integer(oid_float8());
}

spec is_text {
    then is_text(oid_text());
    then is_text(oid_varchar());
    then is_text(oid_uuid());
    then !is_text(oid_int4());
}

spec is_float {
    then is_float(oid_float4());
    then is_float(oid_float8());
    then is_float(oid_numeric());
    then !is_float(oid_int4());
}

spec is_temporal {
    then is_temporal(oid_date());
    then is_temporal(oid_timestamptz());
    then !is_temporal(oid_text());
}

spec is_float_array {
    then is_float_array(oid_float8_array());
    then is_float_array(oid_float4_array());
    then !is_float_array(oid_float8());
}

spec as_floats {
    // The renderings a float8[] column and a pgvector column produce.
    then floats_len("{0.1,0.2,0.3}") == 3;
    then floats_len("[0.1,0.2,0.3]") == 3;
    then floats_at_near("{0.1,0.2,0.3}", 1, 0.2);
    then floats_at_near("[-1.5,2e2,0]", 1, 200.0);
    then floats_at_near("[-1.5,2e2,0]", 0, 0.0 - 1.5);
    then floats_len("{}") == 0;
    then floats_len("[]") == 0;
    then floats_len("{ 1.0 , 2.0 }") == 2;
    // Malformed input is an Err, never a shorter vector.
    then floats_reject("");
    then floats_reject("{");
    then floats_reject("{1,2");
    then floats_reject("[1,2}");
    then floats_reject("{1,,2}");
    then floats_reject("{1,2,}");
    then floats_reject("{1,NULL}");
    then floats_reject("{{1,2},{3,4}}");
    then floats_reject("{1,abc}");
    then floats_reject("1,2,3");
}

spec array_literal {
    then array_literal_is(0.1, 0.2, 0.3, "{0.1,0.2,0.3}");
    then array_literal_is(1.0, 0.0 - 1.25, 0.5, "{1.0,-1.25,0.5}");
    then empty_literal_is("{}");
}

spec vector_literal {
    then vector_literal_is(0.1, 0.2, 0.3, "[0.1,0.2,0.3]");
    // Encode then decode returns the same vector, in both bracket forms.
    then floats_round_trip(0.1, 0.2, 0.3);
    then floats_round_trip(0.0 - 0.031415927, 0.70710678, 0.0);
}
