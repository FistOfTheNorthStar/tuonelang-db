// db::bytes — the byte-order layer database wire protocols are framed in.
//
// This is part of the backend-neutral `core` feature: nothing here is specific
// to any one database. Big-endian framing is how most database wire protocols
// are built, so this module is the seam a second backend is written against.
//
// PostgreSQL, the backend that exists today, is the worked example: every
// message is length-prefixed with a big-endian Int32, and every field inside
// one — a parameter length in `Bind`, a column length in `DataRow`, an object
// id in `RowDescription` — is big-endian too. So this is the single most-used
// module in the adapter, and the one whose correctness everything else rests
// on.
//
// WHY ARITHMETIC AND NOT SHIFTS.
//
// These encoders were written before tuonelang had bitwise operators, with
// `*`, `/`, and `%` standing in for shifts and masks. **ADR-0019 Stage A has
// since landed** `<<`/`>>`/`&`/`|`/`^`/`~`, so shifts are available now; the
// `std::bits` helpers the ADR also promises (`be_u32`, `be_u16`, and their
// decoders) are Stage B and still resolve to `R0002: no 'bits' in 'std'`.
//
// The arithmetic below is left in place deliberately: it is exactly equivalent
// to the shift form **provided every byte is in 0..=255 and no intermediate
// overflows**, and those are the two conditions this module enforces rather
// than assumes:
//
//   * every decoder is fed bytes from `std::string::byte_at`, which the
//     compiler guarantees is `0..=255`; and
//   * `i32` values are reassembled below 2^31 and sign-corrected explicitly
//     in `be_i32`, so the multiply-add never carries into a sign bit the way
//     ADR-0019 warns an unguarded `*`-based decoder does.
//
// MIGRATION. The bodies here can become one-liners — over the Stage A shifts
// today, or over `std::bits` once Stage B lands — while every signature and
// every spec below stays as-is. That is the point of routing all byte-order
// work through this one module instead of open-coding `b0 * 16777216 + ...`
// at each call site, which is the correctness trap the ADR calls out by name.
// The specs are what make that rewrite safe to attempt.

module db::bytes;

// ----------------------------------------------------------------------------
// Constants — the powers of two the big-endian codec needs.
//
// Written as functions because v0 has no `const` items; the optimizer folds
// them, and naming them keeps the magic numbers out of the encoders.
// ----------------------------------------------------------------------------

/// 2^8 — one byte's worth of range.
pub fn byte_max() -> Int {
    256
}

/// 2^16.
pub fn pow16() -> Int {
    65536
}

/// 2^24.
pub fn pow24() -> Int {
    16777216
}

/// 2^32 — the modulus an unsigned 32-bit quantity wraps at.
pub fn pow32() -> Int {
    4294967296
}

/// 2^31 — the first value an `Int32` represents as negative.
pub fn int32_sign_bit() -> Int {
    2147483648
}

// ----------------------------------------------------------------------------
// Encoding — appending big-endian integers to an owned buffer.
// ----------------------------------------------------------------------------

/// Append `v` as a big-endian **Int32** (4 bytes), the width every PostgreSQL
/// length prefix and object id uses.
///
/// Negative values are encoded in two's complement, which is how the protocol
/// spells the `-1` that means SQL NULL in a `DataRow` column length and
/// "unspecified" in a `Bind` parameter length.
///
/// # Example
/// ```tuo
/// var buf = std::string::empty();
/// db::bytes::put_i32(buf, 196608); // the 3.0 protocol version
/// ```
pub fn put_i32(mut buf: String, take v: Int) {
    // Fold a negative into its unsigned two's-complement image first, so the
    // four extractions below are always over a non-negative number.
    var n = v;
    if n < 0 {
        n = n + pow32();
    }
    std::string::push_byte(buf, n / pow24() % byte_max());
    std::string::push_byte(buf, n / pow16() % byte_max());
    std::string::push_byte(buf, n / byte_max() % byte_max());
    std::string::push_byte(buf, n % byte_max());
}

/// Append `v` as a big-endian **Int16** (2 bytes) — the width of a column
/// count, a parameter count, and a format code.
///
/// # Example
/// ```tuo
/// var buf = std::string::empty();
/// db::bytes::put_i16(buf, 1);
/// ```
pub fn put_i16(mut buf: String, take v: Int) {
    var n = v;
    if n < 0 {
        n = n + pow16();
    }
    std::string::push_byte(buf, n / byte_max() % byte_max());
    std::string::push_byte(buf, n % byte_max());
}

/// Append one byte.
///
/// # Example
/// ```tuo
/// var buf = std::string::empty();
/// db::bytes::put_byte(buf, 83); // 'S'
/// ```
pub fn put_byte(mut buf: String, take b: Int) {
    std::string::push_byte(buf, b);
}

/// Append a **C string**: the bytes of `s` followed by a NUL terminator.
///
/// This is how the protocol frames every identifier, SQL string, and startup
/// parameter. `String` holds embedded NULs faithfully (it is a byte buffer,
/// not a C string), so the terminator is data like any other byte.
///
/// # Example
/// ```tuo
/// var buf = std::string::empty();
/// db::bytes::put_cstr(buf, "SELECT 1");
/// ```
pub fn put_cstr(mut buf: String, in s: Str) {
    std::string::append(buf, s);
    std::string::push_byte(buf, 0);
}

/// Append the raw bytes of `s` with **no** terminator and no length prefix.
///
/// # Example
/// ```tuo
/// var buf = std::string::empty();
/// db::bytes::put_bytes(buf, "raw");
/// ```
pub fn put_bytes(mut buf: String, in s: Str) {
    std::string::append(buf, s);
}

// ----------------------------------------------------------------------------
// Decoding — reading big-endian integers back out of a buffer.
// ----------------------------------------------------------------------------

/// The big-endian **Int32** at byte offset `at` of `buf`, interpreted as
/// **signed** two's complement.
///
/// Signedness matters: a `DataRow` column length of `-1` means SQL NULL, and
/// reading it as unsigned would yield 4294967295 and misframe every column
/// after it.
///
/// Traps `IndexOutOfBounds` unless `at + 4 <= len(buf)`.
///
/// # Example
/// ```tuo
/// // let n = db::bytes::be_i32(buf, 0);
/// ```
pub fn be_i32(in buf: String, take at: Int) -> Int {
    let n = be_u32(buf, at);
    // Reinterpret the top bit as a sign, which is what makes -1 read as -1.
    if n >= int32_sign_bit() {
        n - pow32()
    } else {
        n
    }
}

/// The big-endian **Int32** at `at`, interpreted as **unsigned** (0..2^32).
///
/// Used where the protocol's value is by definition non-negative — an object
/// id, for instance — and a sign reinterpretation would be wrong.
///
/// # Example
/// ```tuo
/// // let oid = db::bytes::be_u32(buf, 6);
/// ```
pub fn be_u32(in buf: String, take at: Int) -> Int {
    let b0 = std::string::byte_at(buf, at);
    let b1 = std::string::byte_at(buf, at + 1);
    let b2 = std::string::byte_at(buf, at + 2);
    let b3 = std::string::byte_at(buf, at + 3);
    b0 * pow24() + b1 * pow16() + b2 * byte_max() + b3
}

/// The big-endian **Int16** at `at`, interpreted as signed.
///
/// # Example
/// ```tuo
/// // let cols = db::bytes::be_i16(buf, 5);
/// ```
pub fn be_i16(in buf: String, take at: Int) -> Int {
    let hi = std::string::byte_at(buf, at);
    let lo = std::string::byte_at(buf, at + 1);
    let n = hi * byte_max() + lo;
    if n >= 32768 {
        n - pow16()
    } else {
        n
    }
}

/// The NUL-terminated string starting at `at`, **excluding** the terminator.
///
/// When no terminator is found before the end of the buffer, the remainder of
/// the buffer is returned — a truncated message is a protocol error the caller
/// detects by framing, and this never reads out of bounds.
///
/// # Example
/// ```tuo
/// // let name = db::bytes::cstr_at(buf, 5);
/// ```
pub fn cstr_at(in buf: String, take at: Int) -> String {
    let stop = std::string::len(buf);
    var i = at;
    while i < stop {
        if std::string::byte_at(buf, i) == 0 {
            return std::string::slice(buf, at, i);
        }
        i = i + 1;
    }
    std::string::slice(buf, at, stop)
}

/// The offset just past the NUL terminator of the C string at `at` — i.e.
/// where the next field begins.
///
/// Pairs with `cstr_at` to walk a run of C strings, which is how
/// `ErrorResponse` and `RowDescription` are laid out.
///
/// # Example
/// ```tuo
/// // let next = db::bytes::cstr_end(buf, 5);
/// ```
pub fn cstr_end(in buf: String, take at: Int) -> Int {
    let stop = std::string::len(buf);
    var i = at;
    while i < stop {
        if std::string::byte_at(buf, i) == 0 {
            return i + 1;
        }
        i = i + 1;
    }
    stop
}

// ----------------------------------------------------------------------------
// Specs — round-trip and boundary proofs.
//
// These are the invariants the whole adapter leans on, so they are pinned at
// the exact values the protocol actually uses (196608 = 3.0, -1 = NULL) and at
// the two's-complement boundaries where an arithmetic codec would break.
// ----------------------------------------------------------------------------

/// Spec helper: encode `v` as i32 and decode it back.
pub fn roundtrip_i32(take v: Int) -> Int {
    var buf = std::string::empty();
    put_i32(buf, v);
    be_i32(buf, 0)
}

/// Spec helper: encode `v` as i16 and decode it back.
pub fn roundtrip_i16(take v: Int) -> Int {
    var buf = std::string::empty();
    put_i16(buf, v);
    be_i16(buf, 0)
}

/// Spec helper: the byte length `put_i32` appends.
pub fn i32_width() -> Int {
    var buf = std::string::empty();
    put_i32(buf, 0);
    std::string::len(buf)
}

/// Spec helper: decode a C string written at offset 0 and compare it.
pub fn cstr_roundtrip_ok(in s: Str) -> Bool {
    var buf = std::string::empty();
    put_cstr(buf, s);
    std::string::as_str(cstr_at(buf, 0)) == s
}

/// Spec helper: where the field after a written C string starts.
pub fn cstr_next_offset(in s: Str) -> Int {
    var buf = std::string::empty();
    put_cstr(buf, s);
    cstr_end(buf, 0)
}

spec roundtrip_i32 {
    then roundtrip_i32(0) == 0;
    then roundtrip_i32(1) == 1;
    // The protocol version constant — the first i32 any client ever sends.
    then roundtrip_i32(196608) == 196608;
    // SQL NULL as a DataRow column length. The case an unsigned-only decoder
    // gets wrong, and the reason `be_i32` sign-corrects.
    then roundtrip_i32(0 - 1) == 0 - 1;
    then roundtrip_i32(0 - 2) == 0 - 2;
    // Two's-complement extremes.
    then roundtrip_i32(2147483647) == 2147483647;
    then roundtrip_i32(0 - 2147483648) == 0 - 2147483648;
    // A value with the high bit of each byte set, which a carrying encoder
    // would corrupt.
    then roundtrip_i32(0 - 129) == 0 - 129;
}

spec roundtrip_i16 {
    then roundtrip_i16(0) == 0;
    then roundtrip_i16(1) == 1;
    then roundtrip_i16(32767) == 32767;
    then roundtrip_i16(0 - 1) == 0 - 1;
    then roundtrip_i16(0 - 32768) == 0 - 32768;
}

spec i32_width {
    then i32_width() == 4;
}

spec be_u32 {
    // Unsigned reading of the same bytes that `be_i32` reports as -1.
    then unsigned_of_negative_one() == 4294967295;
}

/// Spec helper: the unsigned reading of the bytes `put_i32(-1)` writes.
pub fn unsigned_of_negative_one() -> Int {
    var buf = std::string::empty();
    put_i32(buf, 0 - 1);
    be_u32(buf, 0)
}

spec cstr_roundtrip_ok {
    then cstr_roundtrip_ok("");
    then cstr_roundtrip_ok("user");
    then cstr_roundtrip_ok("SELECT 1");
    then cstr_roundtrip_ok("deepflaws");
}

spec cstr_next_offset {
    then cstr_next_offset("") == 1;
    then cstr_next_offset("user") == 5;
    then cstr_next_offset("SELECT 1") == 9;
}
