// live_check — the adapter's acceptance oracle, run against a real server.
//
// The pure tiers of this adapter carry the executable specs, but a spec cannot
// touch a socket (`R0007`), so the effect tier — connecting, the handshake,
// framing messages off a live stream — needs a different kind of proof. This
// program is it: it connects to a real PostgreSQL server, runs real SQL, and
// exits non-zero the moment anything disagrees with what the pure tiers say
// should happen.
//
// It is deliberately written as a **cross-check**, not a smoke test. Each step
// asserts a value the pure layer predicts, so a passing run means the wire
// agrees with the model rather than merely that bytes moved.
//
// Run it against the throwaway server `examples/test-server.sh start` brings up:
//
//     tuo run examples/live_check.tuo src/db/*.tuo src/pg/*.tuo
//
// Exit codes — each names exactly one failed expectation:
//
//     0   every check passed
//     10  could not connect or the handshake failed
//     11  SELECT 1 did not return the single value 1
//     12  arithmetic/NULL row did not decode as predicted
//     13  column metadata (names, OIDs) disagreed
//     14  a parameterized query did not round-trip its parameter
//     15  a deliberate SQL error was not reported as a server error
//     16  multi-row ordering or row counts were wrong
//     17  a NULL parameter did not arrive as SQL NULL
//     18  two row-returning statements were not refused, or wedged the connection
//     19  COPY was not refused as unsupported, or wedged the connection
//     20  65536 parameters were sent instead of refused, or wedged the connection
//     21  a million-row result was truncated, or left rows behind for the next query
//     22  an out-of-range cell read did not read as NULL
//     23  a timeout did not close the descriptor, or the closed descriptor still answered
//
// The connection parameters below are that test server's, and exist for
// nothing else. It demands SCRAM-SHA-256, so every run authenticates with
// it; pointed elsewhere, the adapter answers whatever method is asked for,
// and `auth_check.tuo` is the oracle that proves which one was demanded.

module live_check;

/// The server address. Numeric, because v0 has no DNS (ADR-0017).
fn host() -> Str {
    "127.0.0.1"
}

/// The test server's port — not 5432, so it never collides with a real one.
fn port() -> Int {
    54320
}

/// The database user.
fn user() -> Str {
    "tuo"
}

/// The database name.
fn database() -> Str {
    "tuo_test"
}

/// The password. Unused under `trust`; otherwise proven or sent as the
/// server's authentication method requires.
fn password() -> Str {
    "tuo-test-only"
}

/// A generous per-operation timeout: every wait in the adapter is bounded, so
/// a server that goes away fails this program rather than hanging it.
fn timeout_ms() -> Int {
    5000
}

/// Report a step's outcome on stdout, so a failing run says which check broke.
fn say(in label: Str) -> Int {
    let _ = std::rt::write(1, label);
    std::rt::write(1, "\n")
}

fn main() -> Int {
    // --- Connect and complete the startup handshake ------------------------
    let connected = pg::conn::connect(host(), port(), user(), database(), password(), timeout_ms());
    if !pg::conn::is_ok_int(connected) {
        let _ = std::rt::write(1, "FAIL connect: ");
        let _ = std::rt::write_string(1, db::error::render(pg::conn::unwrap_err_int(connected)));
        let _ = std::rt::write(1, "\n");
        return 10;
    }
    let fd = pg::conn::unwrap_ok_int(connected);
    let _ = say("ok   connect + handshake");

    // --- 1. The simplest possible query -----------------------------------
    // Proves framing, RowDescription, DataRow, CommandComplete, and
    // ReadyForQuery all agree end to end.
    let r1 = pg::query::run(fd, "SELECT 1", timeout_ms());
    if !pg::query::is_ok_result(r1) {
        let _ = std::rt::write_string(1, pg::query::render_error(r1));
        let _ = pg::conn::shutdown(fd);
        return 11;
    }
    let rs1 = pg::query::unwrap_ok_result(r1);
    if pg::query::row_count(rs1) != 1 || pg::query::column_count(rs1) != 1 || pg::query::cell_int(rs1, 0, 0, 0) != 1 {
        let _ = say("FAIL SELECT 1");
        let _ = pg::conn::shutdown(fd);
        return 11;
    }
    let _ = say("ok   SELECT 1");

    // --- 2. Types and NULL -------------------------------------------------
    // A row mixing an int, a text, a bool, a float, and a NULL. This is the
    // check that catches a framing bug after a NULL column, which is the
    // classic wire-protocol defect.
    let r2 = pg::query::run(fd, "SELECT 42, 'ada', true, 3.5, NULL::text", timeout_ms());
    if !pg::query::is_ok_result(r2) {
        let _ = std::rt::write_string(1, pg::query::render_error(r2));
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    let rs2 = pg::query::unwrap_ok_result(r2);
    if pg::query::column_count(rs2) != 5 {
        let _ = say("FAIL typed row: column count");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    if pg::query::cell_int(rs2, 0, 0, 0) != 42 {
        let _ = say("FAIL typed row: int");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    if std::string::as_str(pg::query::cell(rs2, 0, 1)) != "ada" {
        let _ = say("FAIL typed row: text");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    if !pg::query::cell_bool(rs2, 0, 2) {
        let _ = say("FAIL typed row: bool");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    if pg::query::cell_float(rs2, 0, 3, 0.0) != 3.5 {
        let _ = say("FAIL typed row: float");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    // The NULL must be reported as NULL, and must not be confused with ''.
    if !pg::query::is_null(rs2, 0, 4) {
        let _ = say("FAIL typed row: NULL not detected");
        let _ = pg::conn::shutdown(fd);
        return 12;
    }
    let _ = say("ok   int / text / bool / float / NULL");

    // --- 3. Column metadata ------------------------------------------------
    // The names and type OIDs the server reports must match what `pg::value`
    // claims they are.
    let r3 = pg::query::run(fd, "SELECT 7 AS id, 'x' AS label", timeout_ms());
    if !pg::query::is_ok_result(r3) {
        let _ = pg::conn::shutdown(fd);
        return 13;
    }
    let rs3 = pg::query::unwrap_ok_result(r3);
    if pg::query::column_index(rs3, "id") != 0 || pg::query::column_index(rs3, "label") != 1 {
        let _ = say("FAIL metadata: column names");
        let _ = pg::conn::shutdown(fd);
        return 13;
    }
    // A bare integer literal is int4; a bare quoted literal is unknown/text.
    if !pg::value::is_integer(pg::query::column_oid(rs3, 0)) {
        let _ = say("FAIL metadata: id is not an integer type");
        let _ = pg::conn::shutdown(fd);
        return 13;
    }
    if pg::query::column_index(rs3, "nope") != 0 - 1 {
        let _ = say("FAIL metadata: absent column should be -1");
        let _ = pg::conn::shutdown(fd);
        return 13;
    }
    let _ = say("ok   column names and type OIDs");

    // --- 4. The extended protocol, with a parameter ------------------------
    // The injection-safe path: the value travels outside the SQL text and
    // must come back unchanged.
    var params = std::array::empty();
    std::array::push(params, std::string::from_str("hello"));
    let r4 = pg::query::run_params(fd, "SELECT $1", params, timeout_ms());
    if !pg::query::is_ok_result(r4) {
        let _ = std::rt::write_string(1, pg::query::render_error(r4));
        let _ = pg::conn::shutdown(fd);
        return 14;
    }
    let rs4 = pg::query::unwrap_ok_result(r4);
    // Bind the cell before comparing it. A `String` temporary created inside a
    // short-circuiting `||` is dropped on one arm and still read on the other,
    // which lowers to MIR that fails verification (`M0005`); binding it first
    // gives it one owner and one drop.
    let echoed = pg::query::cell(rs4, 0, 0);
    if pg::query::row_count(rs4) != 1 || std::string::as_str(echoed) != "hello" {
        let _ = say("FAIL parameterized query round-trip");
        let _ = pg::conn::shutdown(fd);
        return 14;
    }
    let _ = say("ok   parameterized query ($1 round-trip)");

    // --- 4b. A NULL parameter ----------------------------------------------
    // NULL has no text form, so it travels as a -1 length in Bind. The server
    // must see it as NULL — not as '' — and hand it back as NULL.
    var null_params = std::array::empty();
    std::array::push(null_params, std::string::from_str("ignored"));
    var null_flags = std::array::empty();
    std::array::push(null_flags, 1);
    let r4n = pg::query::run_params_null(fd, "SELECT $1::text IS NULL, $1::text", null_params, null_flags, timeout_ms());
    if !pg::query::is_ok_result(r4n) {
        let _ = std::rt::write_string(1, pg::query::render_error(r4n));
        let _ = pg::conn::shutdown(fd);
        return 17;
    }
    let rs4n = pg::query::unwrap_ok_result(r4n);
    if !pg::query::cell_bool(rs4n, 0, 0) || !pg::query::is_null(rs4n, 0, 1) {
        let _ = say("FAIL NULL parameter arrived as a value");
        let _ = pg::conn::shutdown(fd);
        return 17;
    }
    let _ = say("ok   NULL parameter (length -1 in Bind)");

    // --- 5. A real server error --------------------------------------------
    // A deliberate syntax error must arrive as a typed server error carrying
    // SQLSTATE 42601 — and the connection must remain usable afterwards,
    // which is what draining to ReadyForQuery buys.
    let r5 = pg::query::run(fd, "SELCT bad syntax", timeout_ms());
    if pg::query::is_ok_result(r5) {
        let _ = say("FAIL error: a syntax error was reported as success");
        let _ = pg::conn::shutdown(fd);
        return 15;
    }
    let e5 = pg::query::unwrap_err_result(r5);
    if db::error::kind(e5) != db::error::kind_server() {
        let _ = say("FAIL error: wrong error kind");
        let _ = pg::conn::shutdown(fd);
        return 15;
    }
    if !db::error::is_sqlstate(e5, db::error::sqlstate_syntax_error()) {
        let _ = say("FAIL error: wrong SQLSTATE");
        let _ = pg::conn::shutdown(fd);
        return 15;
    }
    let _ = say("ok   syntax error -> SQLSTATE 42601");

    // --- 6. The connection survived the error ------------------------------
    // If the error path had left an unread message on the stream, this query
    // would read it and desynchronize. That it succeeds proves the drain.
    let r6 = pg::query::run(fd, "SELECT n FROM generate_series(1, 3) AS n ORDER BY n", timeout_ms());
    if !pg::query::is_ok_result(r6) {
        let _ = say("FAIL recovery: connection unusable after an error");
        let _ = pg::conn::shutdown(fd);
        return 16;
    }
    let rs6 = pg::query::unwrap_ok_result(r6);
    if pg::query::row_count(rs6) != 3 {
        let _ = say("FAIL multi-row: wrong row count");
        let _ = pg::conn::shutdown(fd);
        return 16;
    }
    if pg::query::cell_int(rs6, 0, 0, 0) != 1 || pg::query::cell_int(rs6, 1, 0, 0) != 2 || pg::query::cell_int(rs6, 2, 0, 0) != 3 {
        let _ = say("FAIL multi-row: wrong values or order");
        let _ = pg::conn::shutdown(fd);
        return 16;
    }
    // The command tag must report the same count the rows do.
    if pg::query::affected(rs6) != 3 {
        let _ = say("FAIL multi-row: command tag disagrees with row count");
        let _ = pg::conn::shutdown(fd);
        return 16;
    }
    let _ = say("ok   multi-row ordering + command tag");
    let _ = say("ok   connection reusable after a server error");

    // --- 7. Two result sets in one query -----------------------------------
    // A ResultSet holds one result, so a second RowDescription must be
    // refused as unsupported rather than merged — and, as with a server
    // error, the stream must still be drained so the next query works.
    let r7 = pg::query::run(fd, "SELECT 1; SELECT 2, 3", timeout_ms());
    if pg::query::is_ok_result(r7) {
        let _ = say("FAIL multi-result: two result sets were merged");
        let _ = pg::conn::shutdown(fd);
        return 18;
    }
    let e7 = pg::query::unwrap_err_result(r7);
    if db::error::kind(e7) != db::error::kind_unsupported() {
        let _ = say("FAIL multi-result: wrong error kind");
        let _ = pg::conn::shutdown(fd);
        return 18;
    }
    // Several statements with only one row-returning one are fine, and the
    // tag is the last statement's.
    let r7b = pg::query::run(fd, "CREATE TEMP TABLE m (a int); INSERT INTO m VALUES (1), (2); SELECT a FROM m ORDER BY a", timeout_ms());
    if !pg::query::is_ok_result(r7b) {
        let _ = say("FAIL multi-result: connection unusable, or a single result set was refused");
        let _ = pg::conn::shutdown(fd);
        return 18;
    }
    let rs7b = pg::query::unwrap_ok_result(r7b);
    if pg::query::row_count(rs7b) != 2 || pg::query::cell_int(rs7b, 1, 0, 0) != 2 {
        let _ = say("FAIL multi-result: the surviving result set is wrong");
        let _ = pg::conn::shutdown(fd);
        return 18;
    }
    let _ = say("ok   two result sets refused; one among many accepted");

    // --- 8. COPY, both directions ------------------------------------------
    // COPY TO streams data the adapter has nowhere to put; COPY FROM STDIN
    // leaves the server waiting for rows. Both must be refused as
    // unsupported — never an empty "success" — and the second needs a
    // CopyFail on the wire, or the connection is wedged for good.
    let r8 = pg::query::run(fd, "COPY (SELECT 1) TO STDOUT", timeout_ms());
    if pg::query::is_ok_result(r8) {
        let _ = say("FAIL COPY TO: reported as success");
        let _ = pg::conn::shutdown(fd);
        return 19;
    }
    let e8 = pg::query::unwrap_err_result(r8);
    if db::error::kind(e8) != db::error::kind_unsupported() {
        let _ = say("FAIL COPY TO: wrong error kind");
        let _ = pg::conn::shutdown(fd);
        return 19;
    }
    let _ = pg::query::execute(fd, "CREATE TEMP TABLE cp (a int)", timeout_ms());
    let r8b = pg::query::run(fd, "COPY cp FROM STDIN", timeout_ms());
    if pg::query::is_ok_result(r8b) {
        let _ = say("FAIL COPY FROM STDIN: reported as success");
        let _ = pg::conn::shutdown(fd);
        return 19;
    }
    let e8b = pg::query::unwrap_err_result(r8b);
    if db::error::kind(e8b) != db::error::kind_unsupported() {
        let _ = say("FAIL COPY FROM STDIN: wrong error kind");
        let _ = pg::conn::shutdown(fd);
        return 19;
    }
    // The CopyFail must have ended the exchange: the next query works, and
    // fast — a wedged connection would time out here instead.
    let r8c = pg::query::scalar_int(fd, "SELECT count(*) FROM cp", 0 - 1, timeout_ms());
    if !pg::conn::is_ok_int(r8c) || pg::conn::unwrap_ok_int(r8c) != 0 {
        let _ = say("FAIL COPY FROM STDIN: connection unusable afterwards");
        let _ = pg::conn::shutdown(fd);
        return 19;
    }
    let _ = say("ok   COPY refused both ways; connection survives CopyFail");

    // --- 9. Too many parameters -------------------------------------------
    // The Bind count is an Int16. One past it must be refused before a byte
    // is sent — a wrapped count would desynchronize the connection — and the
    // next query must work.
    var many = std::array::empty();
    var k = 0;
    while k <= pg::query::max_params() {
        std::array::push(many, std::string::from_str("1"));
        k = k + 1;
    }
    let r9 = pg::query::run_params(fd, "SELECT $1", many, timeout_ms());
    if pg::query::is_ok_result(r9) {
        let _ = say("FAIL params: 65536 parameters were accepted");
        let _ = pg::conn::shutdown(fd);
        return 20;
    }
    let e9 = pg::query::unwrap_err_result(r9);
    if db::error::kind(e9) != db::error::kind_unsupported() {
        let _ = say("FAIL params: wrong error kind");
        let _ = pg::conn::shutdown(fd);
        return 20;
    }
    let r9b = pg::query::scalar_int(fd, "SELECT 9", 0, timeout_ms());
    if !pg::conn::is_ok_int(r9b) || pg::conn::unwrap_ok_int(r9b) != 9 {
        let _ = say("FAIL params: connection unusable after the refusal");
        let _ = pg::conn::shutdown(fd);
        return 20;
    }
    let _ = say("ok   65536 parameters refused before sending");

    // --- 10. A large result ------------------------------------------------
    // More than a million messages in one reply. An earlier build capped the
    // read loop at a million and handed back a truncated result, with the
    // rest still on the stream for the next query to read as its own. Every
    // row must arrive, and the query after it must see its own reply.
    let r10 = pg::query::run(fd, "SELECT generate_series(1, 1000010)", timeout_ms());
    if !pg::query::is_ok_result(r10) {
        let _ = std::rt::write_string(1, pg::query::render_error(r10));
        let _ = pg::conn::shutdown(fd);
        return 21;
    }
    let rs10 = pg::query::unwrap_ok_result(r10);
    if pg::query::row_count(rs10) != 1000010 || pg::query::affected(rs10) != 1000010 {
        let _ = say("FAIL large result: rows were lost");
        let _ = pg::conn::shutdown(fd);
        return 21;
    }
    let r10b = pg::query::scalar_int(fd, "SELECT 10", 0, timeout_ms());
    if !pg::conn::is_ok_int(r10b) || pg::conn::unwrap_ok_int(r10b) != 10 {
        let _ = say("FAIL large result: the next query read leftover rows");
        let _ = pg::conn::shutdown(fd);
        return 21;
    }
    let _ = say("ok   1,000,010 rows in one result; stream in step afterwards");

    // --- 11. Out of range is a value, not a trap ---------------------------
    // Spec-checked on a fixture, but the live result is the one that would
    // have ended a running program with an index trap.
    if std::string::len(pg::query::cell(rs10, 5000000, 0)) != 0 || !pg::query::is_null(rs10, 0, 7) || pg::query::has_cell(rs10, 0, 0 - 1) {
        let _ = say("FAIL out of range: did not read as NULL");
        let _ = pg::conn::shutdown(fd);
        return 22;
    }
    let _ = say("ok   out-of-range cell reads as NULL");

    // --- Done with this connection -----------------------------------------
    let _ = pg::conn::shutdown(fd);

    // --- 12. A timeout closes the descriptor -------------------------------
    // On a fresh connection, because nothing is left to shut down afterwards:
    // a query that outlives its timeout must come back as a fatal timeout,
    // and the next use of that descriptor must be refused rather than handed
    // the sleep's reply as its own.
    let c2 = pg::conn::connect(host(), port(), user(), database(), password(), timeout_ms());
    if !pg::conn::is_ok_int(c2) {
        let _ = say("FAIL connect (second connection)");
        return 10;
    }
    let fd2 = pg::conn::unwrap_ok_int(c2);
    let r12 = pg::query::run(fd2, "SELECT pg_sleep(1.5), 7", 300);
    if pg::query::is_ok_result(r12) {
        let _ = say("FAIL timeout: a 1.5 s query returned within 300 ms");
        let _ = pg::conn::shutdown(fd2);
        return 23;
    }
    let e12 = pg::query::unwrap_err_result(r12);
    if db::error::kind(e12) != db::error::kind_timeout() || !db::error::is_fatal(e12) {
        let _ = say("FAIL timeout: wrong error kind");
        return 23;
    }
    let r12b = pg::query::run(fd2, "SELECT 1", timeout_ms());
    if pg::query::is_ok_result(r12b) {
        let _ = say("FAIL timeout: the closed descriptor still answered");
        return 23;
    }
    let e12b = pg::query::unwrap_err_result(r12b);
    if db::error::kind(e12b) != db::error::kind_connection() {
        let _ = say("FAIL timeout: reuse was not refused as a connection error");
        return 23;
    }
    let _ = say("ok   timeout closes the descriptor; reuse is refused");

    // --- Done --------------------------------------------------------------
    let _ = say("");
    let _ = say("all live checks passed");
    0
}
