// crud_check — the guide's patterns, proven against a real server.
//
// `live_check.tuo` proves the protocol; this program proves the **usage
// patterns** that `docs/GUIDE.md` teaches, so the documentation cannot drift
// away from what the library actually does. Each section corresponds to a
// section of the guide, and each failure has its own exit code.
//
// Run it (against the docker-compose Postgres in ../shallowflaws):
//
//     tuo run examples/crud_check.tuo src/db/*.tuo src/pg/*.tuo
//
// Exit codes:
//
//     0   every pattern verified
//     70  could not connect
//     71  the transaction INSERT (GUIDE §5) failed
//     72  a duplicate key was not reported as SQLSTATE 23505 (GUIDE §4)
//     73  the connection was unusable after that error (GUIDE §4)
//     74  an int column was not classified as an integer type (GUIDE §6)
//     75  a text column was not classified as a text type (GUIDE §6)
//     76  scalar_int failed (GUIDE §2)
//     77  the row count was not the expected 3
//     78  execute_params did not report one affected row (GUIDE §3)
//     79  scalar_params did not return the inserted name (GUIDE §3)
//     80  a NULL parameter was stored as a value (GUIDE §3)
//     81  scalar_int_params did not count the rows (GUIDE §3)
//     82  a NULL read back through scalar_params was not an error, or scalar_int did not fall back (GUIDE §2)

fn main() -> Int {
    let opened = pg::conn::connect("127.0.0.1", 5432, "shallowflaws", "deepflaws", "", 30000);
    if !pg::conn::is_ok_int(opened) {
        return 70;
    }
    let dbh = pg::conn::unwrap_ok_int(opened);

    let _ = pg::query::execute(dbh, "CREATE TEMP TABLE u (id int PRIMARY KEY, name text, note text)", 30000);

    // GUIDE §5 — transaction
    let _ = pg::query::execute(dbh, "BEGIN", 30000);
    var params = std::array::empty();
    std::array::push(params, std::string::from_str("ada"));
    let r = pg::query::run_params(dbh, "INSERT INTO u (id, name) VALUES (1, $1)", params, 30000);
    if !pg::query::is_ok_result(r) {
        let _ = pg::query::execute(dbh, "ROLLBACK", 30000);
        let _ = pg::conn::shutdown(dbh);
        return 71;
    }
    let _ = pg::query::unwrap_ok_result(r);
    let _ = pg::query::execute(dbh, "COMMIT", 30000);

    // GUIDE §4 — a real unique violation, matched by SQLSTATE 23505
    let bad = pg::query::run(dbh, "INSERT INTO u (id, name) VALUES (1, 'dup')", 30000);
    var dup_detected = false;
    if !pg::query::is_ok_result(bad) {
        let e = pg::query::unwrap_err_result(bad);
        if db::error::kind(e) == db::error::kind_server() && db::error::is_sqlstate(e, db::error::sqlstate_unique_violation()) {
            dup_detected = true;
        }
    } else {
        let _ = pg::query::unwrap_ok_result(bad);
    }
    if !dup_detected {
        let _ = pg::conn::shutdown(dbh);
        return 72;
    }

    // GUIDE §6 — OID classification (connection still usable after the error)
    let sel = pg::query::run(dbh, "SELECT id, name FROM u", 30000);
    if !pg::query::is_ok_result(sel) {
        let _ = pg::conn::shutdown(dbh);
        return 73;
    }
    let rows = pg::query::unwrap_ok_result(sel);
    if !pg::value::is_integer(pg::query::column_oid(rows, 0)) {
        let _ = pg::conn::shutdown(dbh);
        return 74;
    }
    if !pg::value::is_text(pg::query::column_oid(rows, 1)) {
        let _ = pg::conn::shutdown(dbh);
        return 75;
    }

    // GUIDE §3 — the parameterized conveniences
    var params2 = std::array::empty();
    std::array::push(params2, std::string::from_str("bob"));
    let inserted = pg::query::execute_params(dbh, "INSERT INTO u (id, name) VALUES (2, $1)", params2, 30000);
    if !pg::conn::is_ok_int(inserted) {
        let _ = pg::conn::shutdown(dbh);
        return 78;
    }
    if pg::conn::unwrap_ok_int(inserted) != 1 {
        let _ = pg::conn::shutdown(dbh);
        return 78;
    }
    var params3 = std::array::empty();
    std::array::push(params3, std::string::from_str("2"));
    let named = pg::query::scalar_params(dbh, "SELECT name FROM u WHERE id = $1::int", params3, 30000);
    if !pg::conn::is_ok_string(named) {
        let _ = pg::conn::shutdown(dbh);
        return 79;
    }
    let name = pg::conn::unwrap_ok_string(named);
    if std::string::as_str(name) != "bob" {
        let _ = pg::conn::shutdown(dbh);
        return 79;
    }

    // GUIDE §3 — sending NULL, with the push helpers, reduced by affected_of
    var np = std::array::empty();
    var nn = std::array::empty();
    pg::query::push_param(np, nn, "3");
    pg::query::push_param(np, nn, "cy");
    pg::query::push_null(np, nn);
    let with_null = pg::query::affected_of(pg::query::run_params_null(dbh, "INSERT INTO u (id, name, note) VALUES ($1::int, $2, $3)", np, nn, 30000));
    if !pg::conn::is_ok_int(with_null) {
        let _ = pg::conn::shutdown(dbh);
        return 80;
    }
    let back = pg::query::run(dbh, "SELECT note FROM u WHERE id = 3", 30000);
    if !pg::query::is_ok_result(back) {
        let _ = pg::conn::shutdown(dbh);
        return 80;
    }
    let note = pg::query::unwrap_ok_result(back);
    if pg::query::row_count(note) != 1 || !pg::query::is_null(note, 0, 0) {
        let _ = pg::conn::shutdown(dbh);
        return 80;
    }

    // GUIDE §2 — a NULL is not "" through scalar_params, and is the fallback
    // through scalar_int. The note of id 3 was inserted as NULL above.
    var id3 = std::array::empty();
    std::array::push(id3, std::string::from_str("3"));
    let null_note = pg::query::scalar_params(dbh, "SELECT note FROM u WHERE id = $1::int", id3, 30000);
    if pg::conn::is_ok_string(null_note) {
        let _ = pg::conn::shutdown(dbh);
        return 82;
    }
    let null_err = pg::conn::unwrap_err_string(null_note);
    if db::error::kind(null_err) != db::error::kind_decode() {
        let _ = pg::conn::shutdown(dbh);
        return 82;
    }
    let null_num = pg::query::scalar_int(dbh, "SELECT NULL::int", 0 - 4, 30000);
    if !pg::conn::is_ok_int(null_num) || pg::conn::unwrap_ok_int(null_num) != 0 - 4 {
        let _ = pg::conn::shutdown(dbh);
        return 82;
    }

    // GUIDE §3 — scalar_int_params
    var floor = std::array::empty();
    std::array::push(floor, std::string::from_str("1"));
    let above = pg::query::scalar_int_params(dbh, "SELECT count(*) FROM u WHERE id > $1::int", floor, 0, 30000);
    if !pg::conn::is_ok_int(above) {
        let _ = pg::conn::shutdown(dbh);
        return 81;
    }
    if pg::conn::unwrap_ok_int(above) != 2 {
        let _ = pg::conn::shutdown(dbh);
        return 81;
    }

    // GUIDE §2 — scalar_int
    let total = pg::query::scalar_int(dbh, "SELECT count(*) FROM u", 0, 30000);
    if !pg::conn::is_ok_int(total) {
        let _ = pg::conn::shutdown(dbh);
        return 76;
    }
    let n = pg::conn::unwrap_ok_int(total);

    let _ = pg::conn::shutdown(dbh);
    if n == 3 {
        0
    } else {
        77
    }
}
